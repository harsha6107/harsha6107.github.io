---
import spaceGroteskWoff2 from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import silkscreenWoff2 from '@fontsource/silkscreen/files/silkscreen-latin-400-normal.woff2?url';
import jetbrainsLatinWoff2 from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import '../styles/global.css';
import CommandPalette from '../components/CommandPalette.astro';
import RetroSprite from '../components/RetroSprite.astro';
import RetroSpriteSheet from '../components/RetroSpriteSheet.astro';
import { getSiteData, getSortedProjects, getSortedWriting } from '../utils/content';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  articleDate?: Date;
  showReadingProgress?: boolean;
}

const site = await getSiteData();
const projects = await getSortedProjects();
const posts = await getSortedWriting();

const {
  title,
  description = site.positioningHeadline,
  ogImage = '/og/default.png',
  articleDate,
  showReadingProgress = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? site.links.website).toString();
const ogImageUrl = new URL(ogImage, Astro.site ?? site.links.website).toString();
const currentPath = Astro.url.pathname;

const relicsList = [
  {
    id: 'coin',
    title: 'Mystery ? Coin (Super Mario)',
    hint: 'Hit the [?] Mystery Block on the Player 1 Hero Card.',
    href: '/#hero-heading',
    sprite: 'question-block' as const,
  },
  {
    id: 'pacman',
    title: 'Power Pellet (Pac-Man)',
    hint: 'Chomp a part-number query or pellet in the 26M SKU Maze.',
    href: '/#search-demo',
    sprite: 'pacman' as const,
  },
  {
    id: 'overworld',
    title: 'Star Road Compass (Super Mario World)',
    hint: 'Explore any stage node on the 2D Overworld Map.',
    href: '/#latent-space',
    sprite: 'super-star' as const,
  },
  {
    id: 'tetris',
    title: '4-Line Clear (Tetris)',
    hint: 'Hard-drop the I-piece into the Interlocking Stack Well.',
    href: '/#tetris-stack',
    sprite: 'tetromino-i' as const,
  },
  {
    id: 'triforce',
    title: 'Triforce of Wisdom (Legend of Zelda)',
    hint: 'Enter any Case Study Dungeon—or key in ↑↑↓↓←→←→BA.',
    href: '/projects/catalog-search-26m',
    sprite: 'triforce' as const,
  },
];

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  description: site.positioningHeadline,
  url: site.links.website,
  email: `mailto:${site.email}`,
  sameAs: [site.links.github, site.links.linkedin],
  alumniOf: site.education.map((edu) => ({
    '@type': 'CollegeOrUniversity',
    name: edu.institution,
  })),
  worksFor: {
    '@type': 'Organization',
    name: site.experience[0]?.company ?? 'eParts Services',
  },
  knowsAbout: [
    'Machine Learning Systems',
    'Information Retrieval & Elasticsearch',
    'Retrieval-Augmented Generation (RAG)',
    'Model Context Protocol (MCP)',
    'LLM Agents & Evaluation',
    'Distributed Data Systems & Change Data Capture (CDC)',
  ],
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href={spaceGroteskWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={silkscreenWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={jetbrainsLatinWoff2} crossorigin />
    <style
      is:inline
      set:html={`@font-face{font-family:"Silkscreen";font-style:normal;font-weight:400;font-display:optional;src:url("${silkscreenWoff2}") format("woff2");}@font-face{font-family:"Space Grotesk Variable";font-style:normal;font-weight:300 700;font-display:optional;src:url("${spaceGroteskWoff2}") format("woff2-variations");}@font-face{font-family:"JetBrains Mono Variable";font-style:normal;font-weight:100 800;font-display:optional;src:url("${jetbrainsLatinWoff2}") format("woff2-variations");}`}
    ></style>
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — Technical Writing RSS`}
      href="/rss.xml"
    />

    <!-- OpenGraph & Twitter Cards -->
    <meta property="og:type" content={articleDate ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {articleDate && (
      <meta property="article:published_time" content={articleDate.toISOString()} />
    )}

    <!-- Zero-flash synchronous theme + audience initializer -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const saved = localStorage.getItem('theme');
          const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          const resolved = saved === 'light' || saved === 'dark' ? saved : prefersLight ? 'light' : 'dark';
          root.setAttribute('data-theme', resolved);
          if (localStorage.getItem('audience') === 'recruiter') {
            root.setAttribute('data-audience', 'recruiter');
          }
        } catch {
          root.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  </head>
  <body
    data-email={site.email}
    data-email-feedback={site.ui.copiedEmailFeedback}
    data-greeting={site.consoleGreeting}
  >
    <RetroSpriteSheet />
    <a href="#main-content" class="skip-link">{site.ui.skipToContent}</a>

    {showReadingProgress && <div class="reading-progress" aria-hidden="true"></div>}

    <header class="site-header">
      <div class="container nav-inner">
        <a href="/" class="brand-link">
          <span class="brand-monogram" aria-hidden="true">{site.monogram}</span>
          <span class="brand-meta">
            <span class="brand-name">{site.name}</span>
            <span class="brand-role">1UP · LV.05 {site.role.toUpperCase()}</span>
          </span>
        </a>

        <nav aria-label="Primary">
          <ul class="nav-links">
            {site.nav.map((item) => {
              const isActive =
                currentPath === item.href ||
                (item.href !== '/' && currentPath.startsWith(item.href));
              return (
                <li>
                  <a
                    href={item.href}
                    class="nav-link"
                    aria-current={isActive ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>

        <div class="nav-actions">
          <button
            type="button"
            id="quest-trigger"
            class="btn btn-icon quest-btn"
            title="Explorer Quest Log — Discover 5 Retro Relics"
          >
            <RetroSprite name="super-star" size={14} />
            <span class="sr-only">Explorer Quest Log </span>
            <span data-relic-count>0/5</span>
          </button>

          <button
            type="button"
            id="sfx-toggle"
            class="btn btn-icon"
            aria-pressed="false"
            title="Toggle 8-Bit Chiptune SFX (M)"
          >
            <span class="sr-only">8-Bit Sound </span>
            <span data-sfx-label>♪ OFF</span>
          </button>

          <button
            type="button"
            id="cmd-trigger"
            class="btn btn-icon"
            title="Warp Whistle Command Palette (⌘K / Ctrl+K)"
          >
            <span class="sr-only">{site.ui.commandPaletteLabel} </span>
            <span aria-hidden="true">⌘K</span>
          </button>

          <button
            type="button"
            id="theme-toggle"
            class="btn btn-icon"
            title={site.ui.themeToggleLabel}
          >
            <span class="sr-only">{site.ui.themeToggleLabel}</span>
            <span data-theme-icon aria-hidden="true">◐</span>
          </button>
        </div>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container" style="display: flex; flex-direction: column; gap: var(--space-5);">
        <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4);">
          <div>
            <p class="pixel" style="font-size: 0.78rem; color: var(--text-primary); display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
              <RetroSprite name="cartridge" size={16} />
              <span>{site.name}</span>
              <span style="color: var(--accent);">· {site.role}</span>
            </p>
            <p style="font-size: var(--text-xs); color: var(--text-muted); margin-top: 6px; max-width: 72ch;">
              Crafted with Space Grotesk, Silkscreen &amp; JetBrains Mono. Inspired by Pac-Man, Super Mario World, Tetris &amp; The Legend of Zelda—zero AI slopstack, 100% real production metrics.
            </p>
          </div>

          <div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2);">
            <button
              type="button"
              class="btn btn-icon"
              data-copy-email={site.email}
              data-copy-feedback={site.ui.copiedEmailFeedback}
            >
              <span>{site.email}</span>
            </button>
            <a href={site.links.github} class="btn btn-icon" target="_blank" rel="noopener noreferrer">
              GitHub ↗
            </a>
            <a href={site.links.linkedin} class="btn btn-icon" target="_blank" rel="noopener noreferrer">
              LinkedIn ↗
            </a>
            <a href="/rss.xml" class="btn btn-icon">
              RSS
            </a>
            <a href={site.links.source} class="btn btn-icon" target="_blank" rel="noopener noreferrer">
              {site.ui.sourceLabel} ↗
            </a>
          </div>
        </div>

        <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3);">
          <button type="button" class="shortcuts-hint pixel" data-open-shortcuts>
            <kbd class="kbd-badge">?</kbd>
            <span>{site.ui.shortcutsHint} · SECRET CODE: ↑↑↓↓←→←→BA</span>
          </button>
          <span class="pixel" style="font-size: 0.65rem; color: var(--text-muted);">
            CREDIT 01 · PRESS START TO EXPLORE
          </span>
        </div>
      </div>
    </footer>

    <div
      id="copy-toast"
      role="status"
      aria-live="polite"
      class="copy-toast pixel"
      hidden
    ></div>

    <!-- Explorer Quest Log Dialog (5 Collectible Retro Relics) -->
    <dialog id="quest-dialog" class="quest-dialog" aria-labelledby="quest-title">
      <div class="quest-head">
        <div style="display: flex; align-items: center; gap: 8px;">
          <RetroSprite name="triforce" size={18} />
          <h2 id="quest-title" class="pixel" style="font-size: var(--text-base);">
            EXPLORER QUEST LOG
          </h2>
        </div>
        <button type="button" class="btn btn-icon" data-close-quest>
          ESC
        </button>
      </div>

      <p style="font-size: var(--text-xs); color: var(--text-secondary); margin-bottom: var(--space-4);">
        Explore interactive systems across this portfolio to collect all 5 retro artifacts. Progress saves locally in your cartridge slot.
      </p>

      <ul class="quest-list">
        {relicsList.map((r) => (
          <li class="quest-item" data-quest-relic={r.id}>
            <div class="quest-icon">
              <RetroSprite name={r.sprite} size={20} />
            </div>
            <div style="flex: 1; min-width: 0;">
              <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap;">
                <strong style="font-size: var(--text-sm); color: var(--text-primary);">
                  {r.title}
                </strong>
                <span class="pixel quest-state" data-quest-state>LOCKED</span>
              </div>
              <p style="font-size: var(--text-xs); color: var(--text-muted); margin-top: 2px;">
                {r.hint}
              </p>
            </div>
            <a href={r.href} class="btn btn-icon" data-quest-warp>
              WARP →
            </a>
          </li>
        ))}
      </ul>
    </dialog>

    <!-- Keyboard Shortcuts Sheet -->
    <dialog id="shortcuts-dialog" class="shortcuts-dialog" aria-labelledby="shortcuts-title">
      <div class="shortcuts-head">
        <h2 id="shortcuts-title" class="pixel" style="font-size: var(--text-base);">
          {site.ui.shortcutsTitle}
        </h2>
        <button type="button" class="btn btn-icon" data-close-shortcuts>
          {site.ui.shortcutsClose}
        </button>
      </div>
      <dl class="shortcuts-list">
        {site.shortcuts.map((s) => (
          <div class="shortcuts-row">
            <dt>{s.label}</dt>
            <dd>
              {s.keys.map((k) => (
                <kbd class="kbd-badge">{k}</kbd>
              ))}
            </dd>
          </div>
        ))}
        <div class="shortcuts-row">
          <dt>Toggle 8-bit chiptune SFX</dt>
          <dd><kbd class="kbd-badge">M</kbd></dd>
        </div>
        <div class="shortcuts-row">
          <dt>Unlock Star Road (Konami Code)</dt>
          <dd><kbd class="kbd-badge">↑↑↓↓←→←→BA</kbd></dd>
        </div>
      </dl>
    </dialog>

    <CommandPalette
      projects={projects}
      posts={posts}
      email={site.email}
      githubUrl={site.links.github}
      linkedinUrl={site.links.linkedin}
      resumePdfUrl={site.links.resumePdf}
      placeholder={site.ui.commandPalettePlaceholder}
      extras={site.paletteExtras}
      shortcutsLabel={site.ui.shortcutsTitle}
    />

    <script>
      import '../scripts/arcade-shell';
    </script>

    <style>
      .quest-btn {
        background-color: var(--accent-subtle);
        color: var(--accent-ink);
        border-color: var(--border-strong);
      }

      .copy-toast {
        position: fixed;
        bottom: var(--space-5);
        right: var(--space-5);
        z-index: 9000;
        max-width: min(90vw, 28rem);
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-xs);
        border: 2px solid var(--border-frame);
        background-color: var(--accent);
        color: #fffdf7;
        font-size: 0.7rem;
        font-weight: 700;
        box-shadow: var(--shadow-md);
      }

      :global(html[data-theme="dark"]) .copy-toast {
        color: #0b0e1a;
        border-color: #ffffff;
      }

      @media (prefers-reduced-motion: no-preference) {
        .copy-toast:not([hidden]) {
          animation: toast-in 180ms var(--ease-spring) both;
        }

        @keyframes toast-in {
          from {
            opacity: 0;
            transform: translateY(8px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }
      }

      .shortcuts-hint {
        display: none;
        align-self: flex-start;
        align-items: center;
        gap: var(--space-2);
        min-height: 28px;
        padding: 0;
        border: none;
        background: none;
        font-size: 0.68rem;
        color: var(--text-muted);
        cursor: pointer;
      }

      .shortcuts-hint:hover {
        color: var(--accent);
      }

      @media (hover: hover) and (pointer: fine) {
        .shortcuts-hint {
          display: inline-flex;
        }
      }

      .shortcuts-dialog,
      .quest-dialog {
        margin: clamp(3rem, 10vh, 7rem) auto auto;
        width: min(92vw, 34rem);
        padding: var(--space-5);
        border: 3px solid var(--border-strong);
        border-radius: var(--radius-md);
        background-color: var(--bg-surface);
        color: var(--text-primary);
        box-shadow: var(--shadow-dialog);
      }

      .shortcuts-dialog::backdrop,
      .quest-dialog::backdrop {
        background-color: rgba(8, 10, 18, 0.72);
      }

      .shortcuts-head,
      .quest-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        margin-bottom: var(--space-4);
      }

      .quest-list {
        list-style: none;
        display: grid;
        gap: var(--space-2);
      }

      .quest-item {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding: var(--space-3);
        border: 2px solid var(--border-subtle);
        border-radius: var(--radius-xs);
        background-color: var(--bg-subtle);
      }

      .quest-item[data-unlocked] {
        border-color: var(--retro-green-fill);
        background-color: var(--bg-surface);
      }

      .quest-icon {
        width: 2.2rem;
        height: 2.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--bg-surface);
        border: 1.5px solid var(--border-strong);
        flex-shrink: 0;
      }

      .quest-state {
        font-size: 0.64rem;
        color: var(--text-muted);
      }

      .quest-item[data-unlocked] .quest-state {
        color: var(--retro-green);
        font-weight: 700;
      }

      .shortcuts-list {
        display: grid;
        gap: var(--space-1);
      }

      .shortcuts-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        padding: var(--space-2) 0;
        border-top: 1.5px solid var(--border-subtle);
        font-size: var(--text-sm);
      }

      .shortcuts-row dt {
        color: var(--text-secondary);
      }

      .shortcuts-row dd {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-1);
      }

      .shortcuts-row .kbd-badge {
        color: var(--text-primary);
        min-width: 1.6rem;
        justify-content: center;
      }
    </style>
  </body>
</html>
