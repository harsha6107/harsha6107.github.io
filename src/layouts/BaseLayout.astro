---
import '@fontsource-variable/inter/opsz.css';
import interLatinWoff2 from '@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url';
import '@fontsource-variable/jetbrains-mono/wght.css';
import jetbrainsLatinWoff2 from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import '../styles/global.css';
import CommandPalette from '../components/CommandPalette.astro';
import { getSiteData, getSortedProjects, getSortedWriting } from '../utils/content';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  articleDate?: Date;
  showReadingProgress?: boolean;
}

const site = await getSiteData();
const projects = await getSortedProjects();
const posts = await getSortedWriting();

const {
  title,
  description = site.positioningHeadline,
  ogImage = '/og/default.png',
  articleDate,
  showReadingProgress = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? site.links.website).toString();
const ogImageUrl = new URL(ogImage, Astro.site ?? site.links.website).toString();
const currentPath = Astro.url.pathname;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  description: site.positioningHeadline,
  url: site.links.website,
  email: `mailto:${site.email}`,
  sameAs: [site.links.github, site.links.linkedin],
  alumniOf: site.education.map((edu) => ({
    '@type': 'CollegeOrUniversity',
    name: edu.institution,
  })),
  worksFor: {
    '@type': 'Organization',
    name: site.experience[0]?.company ?? 'eParts Services',
  },
  knowsAbout: [
    'Machine Learning Systems',
    'Information Retrieval & Elasticsearch',
    'Retrieval-Augmented Generation (RAG)',
    'Model Context Protocol (MCP)',
    'LLM Agents & Evaluation',
    'Distributed Data Systems & Change Data Capture (CDC)',
  ],
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href={interLatinWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={jetbrainsLatinWoff2} crossorigin />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — Technical Writing RSS`}
      href="/rss.xml"
    />

    <!-- OpenGraph & Twitter Cards -->
    <meta property="og:type" content={articleDate ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {articleDate && (
      <meta property="article:published_time" content={articleDate.toISOString()} />
    )}

    <!-- Zero-flash synchronous theme + audience initializer -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          const saved = localStorage.getItem('theme');
          const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          const resolved = saved === 'light' || saved === 'dark' ? saved : prefersLight ? 'light' : 'dark';
          root.setAttribute('data-theme', resolved);
          if (localStorage.getItem('audience') === 'recruiter') {
            root.setAttribute('data-audience', 'recruiter');
          }
        } catch {
          root.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  </head>
  <body
    data-email={site.email}
    data-email-feedback={site.ui.copiedEmailFeedback}
    data-greeting={site.consoleGreeting}
  >
    <a href="#main-content" class="skip-link">{site.ui.skipToContent}</a>

    {showReadingProgress && <div class="reading-progress" aria-hidden="true"></div>}

    <header class="site-header">
      <div class="container nav-inner">
        <a href="/" class="brand-link">
          <span class="brand-monogram" aria-hidden="true">{site.monogram}</span>
          <span>{site.name}</span>
          <span class="brand-role">// {site.role}</span>
        </a>

        <nav aria-label="Primary">
          <ul class="nav-links">
            {site.nav.map((item) => {
              const isActive =
                currentPath === item.href ||
                (item.href !== '/' && currentPath.startsWith(item.href));
              return (
                <li>
                  <a
                    href={item.href}
                    class="nav-link"
                    aria-current={isActive ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>

        <div class="nav-actions">
          <button
            type="button"
            id="cmd-trigger"
            class="btn btn-icon"
            title="Command Palette (⌘K / Ctrl+K)"
          >
            <span class="sr-only">{site.ui.commandPaletteLabel} </span>
            <span aria-hidden="true">⌘K</span>
          </button>

          <button
            type="button"
            id="theme-toggle"
            class="btn btn-icon"
            title={site.ui.themeToggleLabel}
          >
            <span class="sr-only">{site.ui.themeToggleLabel}</span>
            <span data-theme-icon class="mono" aria-hidden="true">◐</span>
          </button>
        </div>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container" style="display: flex; flex-direction: column; gap: var(--space-5);">
        <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4);">
          <div>
            <p style="font-weight: 600; color: var(--text-primary);">
              {site.name} · <span class="mono" style="font-weight: 400; font-size: var(--text-xs); color: var(--text-muted);">{site.role}</span>
            </p>
            <p style="font-size: var(--text-xs); color: var(--text-muted); margin-top: 4px;">
              {site.footerColophon ?? site.ui.footerColophon}
            </p>
          </div>

          <div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3);" class="mono">
            <button
              type="button"
              class="btn btn-icon"
              data-copy-email={site.email}
              data-copy-feedback={site.ui.copiedEmailFeedback}
            >
              <span>{site.email}</span>
            </button>
            <a href={site.links.github} class="btn btn-icon" target="_blank" rel="noopener noreferrer">
              GitHub ↗
            </a>
            <a href={site.links.linkedin} class="btn btn-icon" target="_blank" rel="noopener noreferrer">
              LinkedIn ↗
            </a>
            <a href="/rss.xml" class="btn btn-icon">
              RSS
            </a>
            <a href={site.links.source} class="btn btn-icon" target="_blank" rel="noopener noreferrer">
              {site.ui.sourceLabel} ↗
            </a>
          </div>
        </div>
        <button type="button" class="shortcuts-hint mono" data-open-shortcuts>
          <kbd class="kbd-badge">?</kbd>
          <span>{site.ui.shortcutsHint}</span>
        </button>
      </div>
    </footer>

    <div
      id="copy-toast"
      role="status"
      aria-live="polite"
      class="copy-toast mono"
      hidden
    ></div>

    <dialog id="shortcuts-dialog" class="shortcuts-dialog" aria-labelledby="shortcuts-title">
      <div class="shortcuts-head">
        <h2 id="shortcuts-title">{site.ui.shortcutsTitle}</h2>
        <button type="button" class="btn btn-icon" data-close-shortcuts>
          {site.ui.shortcutsClose}
        </button>
      </div>
      <dl class="shortcuts-list">
        {site.shortcuts.map((s) => (
          <div class="shortcuts-row">
            <dt>{s.label}</dt>
            <dd>
              {s.keys.map((k) => (
                <kbd class="kbd-badge">{k}</kbd>
              ))}
            </dd>
          </div>
        ))}
      </dl>
    </dialog>

    <CommandPalette
      projects={projects}
      posts={posts}
      email={site.email}
      githubUrl={site.links.github}
      linkedinUrl={site.links.linkedin}
      resumePdfUrl={site.links.resumePdf}
      placeholder={site.ui.commandPalettePlaceholder}
      extras={site.paletteExtras}
      shortcutsLabel={site.ui.shortcutsTitle}
    />

    <!-- Lightweight interaction controller (< 2.5 KB, deferred to idle for 0ms TBT) -->
    <script is:inline>
      (() => {
        const init = () => {
          const root = document.documentElement;
          const themeBtn = document.getElementById('theme-toggle');
          const toast = document.getElementById('copy-toast');
          let toastTimer = null;

          function showToast(msg) {
            if (!toast) return;
            toast.textContent = msg;
            toast.hidden = false;
            if (toastTimer) clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
              toast.hidden = true;
            }, 2400);
          }

          function toggleTheme() {
            const current = root.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
            const next = current === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', next);
            try {
              localStorage.setItem('theme', next);
            } catch {}
            showToast(`Theme set to ${next} mode`);
          }

          if (themeBtn) {
            themeBtn.addEventListener('click', toggleTheme);
          }

          async function copyText(text, feedback) {
            try {
              await navigator.clipboard.writeText(text);
            } catch {
              const ta = document.createElement('textarea');
              ta.value = text;
              document.body.appendChild(ta);
              ta.select();
              document.execCommand('copy');
              ta.remove();
            }
            showToast(feedback || `Copied ${text}`);
          }

          document.querySelectorAll('[data-copy-email]').forEach((btn) => {
            btn.addEventListener('click', () => {
              const email = btn.getAttribute('data-copy-email') || '';
              const fb = btn.getAttribute('data-copy-feedback') || `Copied ${email}`;
              copyText(email, fb);
            });
          });

          // Pointer-tracked spotlight & specular border surfaces
          document
            .querySelectorAll('.spotlight-card, .telemetry-cell, .principle-item, .spec-box')
            .forEach((card) => {
              card.addEventListener(
                'pointermove',
                (e) => {
                  const rect = card.getBoundingClientRect();
                  card.style.setProperty('--spot-x', `${e.clientX - rect.left}px`);
                  card.style.setProperty('--spot-y', `${e.clientY - rect.top}px`);
                },
                { passive: true },
              );
            });

          // Interactive tabular-nums telemetry counter scrub on hover & first scroll
          const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          function scrubCounter(el) {
            if (reducedMotion || el.dataset.animating === '1') return;
            const raw = el.getAttribute('data-count-value') || el.textContent || '';
            const m = raw.match(/^([^0-9]*)(\d+)(.*)$/);
            if (!m) return;
            const prefix = m[1] || '';
            const target = Number.parseInt(m[2], 10);
            const suffix = m[3] || '';
            if (!Number.isFinite(target) || target <= 0) return;
            el.dataset.animating = '1';
            const t0 = performance.now();
            const dur = 320;
            const step = (now) => {
              const p = Math.min(1, (now - t0) / dur);
              const eased = 1 - (1 - p) ** 3;
              const val = Math.round(target * eased);
              el.textContent = `${prefix}${val}${suffix}`;
              if (p < 1) requestAnimationFrame(step);
              else {
                el.textContent = raw;
                el.dataset.animating = '0';
              }
            };
            requestAnimationFrame(step);
          }

          document.querySelectorAll('.telemetry-cell').forEach((cell) => {
            const valEl = cell.querySelector('[data-count-value]');
            if (valEl) {
              cell.addEventListener('pointerenter', () => scrubCounter(valEl), { passive: true });
            }
          });
          window.addEventListener(
            'scroll',
            () => {
              document.querySelectorAll('[data-count-value]').forEach((el) => scrubCounter(el));
            },
            { once: true, passive: true },
          );

          // Command Palette (⌘K / Ctrl+K)
          const dialog = document.getElementById('cmd-palette');
          const cmdTrigger = document.getElementById('cmd-trigger');
          const cmdClose = document.getElementById('cmd-close');
          const cmdInput = document.getElementById('cmd-input');
          const cmdItems = Array.from(document.querySelectorAll('[data-cmd-item]'));
          let activeIdx = 0;

          function visibleItems() {
            return cmdItems.filter((el) => !el.hidden);
          }

          function updateSelection(newIdx) {
            const vis = visibleItems();
            if (vis.length === 0) return;
            activeIdx = ((newIdx % vis.length) + vis.length) % vis.length;
            cmdItems.forEach((el) => el.setAttribute('aria-selected', 'false'));
            const current = vis[activeIdx];
            if (current) {
              current.setAttribute('aria-selected', 'true');
              current.scrollIntoView({ block: 'nearest' });
            }
          }

          function openPalette() {
            if (!dialog || typeof dialog.showModal !== 'function') return;
            if (!dialog.open) {
              dialog.showModal();
            }
            if (cmdInput) {
              cmdInput.value = '';
              filterPalette('');
              cmdInput.focus();
            }
          }

          function closePalette() {
            if (dialog && dialog.open) dialog.close();
          }

          function filterPalette(query) {
            const q = query.trim().toLowerCase();
            cmdItems.forEach((item) => {
              const hay = item.getAttribute('data-label') || '';
              item.hidden = q.length > 0 && !hay.includes(q);
            });
            updateSelection(0);
          }

          const shortcuts = document.getElementById('shortcuts-dialog');
          const body = document.body;
          const email = body.getAttribute('data-email') || '';
          const emailFeedback = body.getAttribute('data-email-feedback') || `Copied ${email}`;

          function openShortcuts() {
            closePalette();
            if (shortcuts && typeof shortcuts.showModal === 'function' && !shortcuts.open) {
              shortcuts.showModal();
            }
          }

          document.querySelectorAll('[data-open-shortcuts]').forEach((btn) => {
            btn.addEventListener('click', openShortcuts);
          });
          document.querySelectorAll('[data-close-shortcuts]').forEach((btn) => {
            btn.addEventListener('click', () => shortcuts && shortcuts.close());
          });
          if (shortcuts) {
            shortcuts.addEventListener('click', (e) => {
              if (e.target === shortcuts) shortcuts.close();
            });
          }

          function executeItem(item) {
            if (!item) return;
            const action = item.getAttribute('data-action');
            const href = item.getAttribute('data-href');
            const payload = item.getAttribute('data-payload');
            closePalette();
            if (action === 'toggle-theme') {
              toggleTheme();
            } else if (action === 'copy-email' && payload) {
              copyText(payload, `Copied ${payload}`);
            } else if (action === 'toast' && payload) {
              showToast(payload);
            } else if (action === 'shortcuts') {
              openShortcuts();
            } else if (href) {
              window.location.href = href;
            }
          }

          if (cmdTrigger) cmdTrigger.addEventListener('click', openPalette);
          if (cmdClose) cmdClose.addEventListener('click', closePalette);

          if (dialog) {
            dialog.addEventListener('click', (e) => {
              if (e.target === dialog) closePalette();
            });
          }

          if (cmdInput) {
            cmdInput.addEventListener('input', (e) => filterPalette(e.target.value));
          }

          cmdItems.forEach((item) => {
            item.addEventListener('click', () => executeItem(item));
          });

          // Audience lens: recruiter (summary) vs engineer (full deep dive)
          function syncAudience() {
            const current = root.getAttribute('data-audience') === 'recruiter' ? 'recruiter' : 'engineer';
            document.querySelectorAll('[data-audience-set]').forEach((b) => {
              b.setAttribute('aria-pressed', String(b.getAttribute('data-audience-set') === current));
            });
          }

          function setAudience(next) {
            root.setAttribute('data-audience', next);
            try {
              localStorage.setItem('audience', next);
            } catch {}
            syncAudience();
          }

          document.querySelectorAll('[data-audience-set]').forEach((b) => {
            b.addEventListener('click', () => setAudience(b.getAttribute('data-audience-set') || 'engineer'));
          });
          document.querySelectorAll('[data-deep-dive-open]').forEach((b) => {
            b.addEventListener('click', () => {
              setAudience('engineer');
              const target = document.getElementById('deep-dive');
              if (target) {
                target.scrollIntoView({ block: 'start' });
                target.focus({ preventScroll: true });
              }
            });
          });
          if (root.getAttribute('data-audience') === 'recruiter') {
            syncAudience();
          }

          // Linear-style keyboard shortcuts (ignored while typing)
          const GO = { h: '/', w: '/projects', n: '/writing', a: '/about', r: '/resume' };
          let goPending = false;
          let goTimer = null;

          function isTyping(el) {
            if (!el || !(el instanceof HTMLElement)) return false;
            return el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName);
          }

          window.addEventListener('keydown', (e) => {
            if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
              e.preventDefault();
              if (dialog && dialog.open) closePalette();
              else openPalette();
              return;
            }
            if (dialog && dialog.open) {
              if (e.key === 'ArrowDown') {
                e.preventDefault();
                updateSelection(activeIdx + 1);
              } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                updateSelection(activeIdx - 1);
              } else if (e.key === 'Enter') {
                e.preventDefault();
                const vis = visibleItems();
                if (vis[activeIdx]) executeItem(vis[activeIdx]);
              }
              return;
            }
            if ((shortcuts && shortcuts.open) || e.metaKey || e.ctrlKey || e.altKey) return;
            if (isTyping(e.target)) return;

            const key = e.key.toLowerCase();
            if (goPending) {
              goPending = false;
              if (goTimer) clearTimeout(goTimer);
              if (GO[key]) {
                e.preventDefault();
                window.location.href = GO[key];
              }
              return;
            }
            if (e.key === '?') {
              e.preventDefault();
              openShortcuts();
            } else if (e.key === '/') {
              e.preventDefault();
              const demoInput = document.getElementById('sd-input');
              if (demoInput) {
                demoInput.scrollIntoView({ block: 'center' });
                demoInput.focus({ preventScroll: true });
                demoInput.select();
              } else {
                openPalette();
              }
            } else if (key === 'g') {
              goPending = true;
              goTimer = setTimeout(() => {
                goPending = false;
              }, 1200);
            } else if (key === 't') {
              toggleTheme();
            } else if (key === 'c' && email) {
              copyText(email, emailFeedback);
            }
          });

          // A note for whoever opens devtools
          const greeting = body.getAttribute('data-greeting');
          if (greeting) console.log(`%c${greeting}`, 'font-family: monospace; color: #e07a3c;');

          // Lazy-load 2D Embedding Map module when scrolled into view
          const explorer = document.querySelector('[data-embedding-explorer]');
          if (explorer) {
            const loadMap = () => {
              import('/scripts/embedding-map.js')
                .then((m) => m.initEmbeddingMap(explorer))
                .catch(() => {});
            };
            if ('IntersectionObserver' in window) {
              const io = new IntersectionObserver(
                (entries) => {
                  if (entries.some((entry) => entry.isIntersecting)) {
                    io.disconnect();
                    loadMap();
                  }
                },
                { rootMargin: '80px' },
              );
              io.observe(explorer);
            } else {
              loadMap();
            }
          }
        };

        let initialized = false;
        const runInit = () => {
          if (initialized) return;
          initialized = true;
          init();
        };
        window.addEventListener('keydown', runInit, { once: true, capture: true });
        window.addEventListener('pointerdown', runInit, { once: true, capture: true, passive: true });
        window.addEventListener('pointermove', runInit, { once: true, capture: true, passive: true });
        window.addEventListener('focusin', runInit, { once: true, capture: true, passive: true });
        window.addEventListener('scroll', runInit, { once: true, capture: true, passive: true });
      })();
    </script>

    <style>
      .copy-toast {
        position: fixed;
        bottom: var(--space-5);
        right: var(--space-5);
        z-index: 9000;
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-sm);
        background-color: var(--text-primary);
        color: var(--bg-canvas);
        font-size: var(--text-xs);
        box-shadow: var(--shadow-md);
      }

      @media (prefers-reduced-motion: no-preference) {
        .copy-toast:not([hidden]) {
          animation: toast-in 200ms var(--ease-spring) both;
        }

        @keyframes toast-in {
          from {
            opacity: 0;
            transform: translateY(8px) scale(0.98);
          }
          to {
            opacity: 1;
            transform: translateY(0) scale(1);
          }
        }
      }

      .shortcuts-hint {
        display: none;
        align-self: flex-start;
        align-items: center;
        gap: var(--space-2);
        min-height: 26px;
        padding: 0;
        border: none;
        background: none;
        font-size: var(--text-xs);
        color: var(--text-muted);
        cursor: pointer;
      }

      .shortcuts-hint:hover {
        color: var(--accent);
      }

      @media (hover: hover) and (pointer: fine) {
        .shortcuts-hint {
          display: inline-flex;
        }
      }

      .shortcuts-dialog {
        margin: clamp(3rem, 12vh, 8rem) auto auto;
        width: min(92vw, 26rem);
        padding: var(--space-5);
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-md);
        background-color: var(--bg-surface);
        color: var(--text-primary);
        box-shadow: var(--shadow-dialog);
      }

      .shortcuts-dialog::backdrop {
        background-color: rgba(10, 12, 16, 0.58);
      }

      .shortcuts-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        margin-bottom: var(--space-4);
      }

      .shortcuts-head h2 {
        font-size: var(--text-lg);
      }

      .shortcuts-list {
        display: grid;
        gap: var(--space-1);
      }

      .shortcuts-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        padding: var(--space-2) 0;
        border-top: 1px solid var(--border-subtle);
        font-size: var(--text-sm);
      }

      .shortcuts-row dt {
        color: var(--text-secondary);
      }

      .shortcuts-row dd {
        display: flex;
        gap: var(--space-1);
      }

      .shortcuts-row .kbd-badge {
        color: var(--text-primary);
        min-width: 1.6rem;
        justify-content: center;
      }

      @media (prefers-reduced-motion: no-preference) {
        .shortcuts-dialog[open] {
          animation: toast-in 200ms var(--ease-out) both;
        }
      }
    </style>
  </body>
</html>
