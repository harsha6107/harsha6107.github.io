---
import '@fontsource-variable/inter/opsz.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import CommandPalette from '../components/CommandPalette.astro';
import { getSiteData, getSortedProjects, getSortedWriting } from '../utils/content';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  articleDate?: Date;
  showReadingProgress?: boolean;
}

const site = await getSiteData();
const projects = await getSortedProjects();
const posts = await getSortedWriting();

const {
  title,
  description = site.positioningHeadline,
  ogImage = '/og/default.png',
  articleDate,
  showReadingProgress = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? site.links.website).toString();
const ogImageUrl = new URL(ogImage, Astro.site ?? site.links.website).toString();
const currentPath = Astro.url.pathname;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  description: site.positioningHeadline,
  url: site.links.website,
  email: `mailto:${site.email}`,
  sameAs: [site.links.github, site.links.linkedin],
  alumniOf: site.education.map((edu) => ({
    '@type': 'CollegeOrUniversity',
    name: edu.institution,
  })),
  worksFor: {
    '@type': 'Organization',
    name: site.experience[0]?.company ?? 'eParts Services',
  },
  knowsAbout: [
    'Machine Learning Systems',
    'Information Retrieval & Elasticsearch',
    'Retrieval-Augmented Generation (RAG)',
    'Model Context Protocol (MCP)',
    'LLM Agents & Evaluation',
    'Distributed Data Systems & Change Data Capture (CDC)',
  ],
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — Technical Writing RSS`}
      href="/rss.xml"
    />

    <!-- OpenGraph & Twitter Cards -->
    <meta property="og:type" content={articleDate ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {articleDate && (
      <meta property="article:published_time" content={articleDate.toISOString()} />
    )}

    <!-- Zero-flash synchronous theme initializer -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          const resolved = saved === 'light' || saved === 'dark' ? saved : prefersLight ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', resolved);
        } catch {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{site.ui.skipToContent}</a>

    {showReadingProgress && <div class="reading-progress" aria-hidden="true"></div>}

    <header class="site-header">
      <div class="container nav-inner">
        <a href="/" class="brand-link">
          <span class="brand-monogram" aria-hidden="true">{site.monogram}</span>
          <span>{site.name}</span>
          <span class="brand-role">// {site.role}</span>
        </a>

        <nav aria-label="Primary">
          <ul class="nav-links">
            {site.nav.map((item) => {
              const isActive =
                currentPath === item.href ||
                (item.href !== '/' && currentPath.startsWith(item.href));
              return (
                <li>
                  <a
                    href={item.href}
                    class="nav-link"
                    aria-current={isActive ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>

        <div class="nav-actions">
          <button
            type="button"
            id="cmd-trigger"
            class="btn btn-icon"
            title="Command Palette (⌘K / Ctrl+K)"
          >
            <span class="sr-only">{site.ui.commandPaletteLabel} </span>
            <span aria-hidden="true">⌘K</span>
          </button>

          <button
            type="button"
            id="theme-toggle"
            class="btn btn-icon"
            title={site.ui.themeToggleLabel}
          >
            <span class="sr-only">{site.ui.themeToggleLabel}</span>
            <span data-theme-icon class="mono" aria-hidden="true">◐</span>
          </button>
        </div>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container" style="display: flex; flex-direction: column; gap: var(--space-5);">
        <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4);">
          <div>
            <p style="font-weight: 600; color: var(--text-primary);">
              {site.name} · <span class="mono" style="font-weight: 400; font-size: var(--text-xs); color: var(--text-muted);">{site.role}</span>
            </p>
            <p style="font-size: var(--text-xs); color: var(--text-muted); margin-top: 4px;">
              {site.footerColophon ?? site.ui.footerColophon}
            </p>
          </div>

          <div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3);" class="mono">
            <button
              type="button"
              class="btn btn-icon"
              data-copy-email={site.email}
              data-copy-feedback={site.ui.copiedEmailFeedback}
            >
              <span>{site.email}</span>
            </button>
            <a href={site.links.github} class="btn btn-icon" target="_blank" rel="noopener noreferrer">
              GitHub ↗
            </a>
            <a href={site.links.linkedin} class="btn btn-icon" target="_blank" rel="noopener noreferrer">
              LinkedIn ↗
            </a>
            <a href="/rss.xml" class="btn btn-icon">
              RSS
            </a>
          </div>
        </div>
      </div>
    </footer>

    <div
      id="copy-toast"
      role="status"
      aria-live="polite"
      class="copy-toast mono"
      hidden
    ></div>

    <CommandPalette
      projects={projects}
      posts={posts}
      email={site.email}
      githubUrl={site.links.github}
      linkedinUrl={site.links.linkedin}
      resumePdfUrl={site.links.resumePdf}
      placeholder={site.ui.commandPalettePlaceholder}
    />

    <!-- Lightweight interaction controller (< 2.5 KB, deferred to idle for 0ms TBT) -->
    <script is:inline>
      (() => {
        const init = () => {
          const root = document.documentElement;
          const themeBtn = document.getElementById('theme-toggle');
          const toast = document.getElementById('copy-toast');
          let toastTimer = null;

          function showToast(msg) {
            if (!toast) return;
            toast.textContent = msg;
            toast.hidden = false;
            if (toastTimer) clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
              toast.hidden = true;
            }, 2400);
          }

          function toggleTheme() {
            const current = root.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
            const next = current === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', next);
            try {
              localStorage.setItem('theme', next);
            } catch {}
            showToast(`Theme set to ${next} mode`);
          }

          if (themeBtn) {
            themeBtn.addEventListener('click', toggleTheme);
          }

          async function copyText(text, feedback) {
            try {
              await navigator.clipboard.writeText(text);
            } catch {
              const ta = document.createElement('textarea');
              ta.value = text;
              document.body.appendChild(ta);
              ta.select();
              document.execCommand('copy');
              ta.remove();
            }
            showToast(feedback || `Copied ${text}`);
          }

          document.querySelectorAll('[data-copy-email]').forEach((btn) => {
            btn.addEventListener('click', () => {
              const email = btn.getAttribute('data-copy-email') || '';
              const fb = btn.getAttribute('data-copy-feedback') || `Copied ${email}`;
              copyText(email, fb);
            });
          });

          // Pointer-tracked spotlight cards
          document.querySelectorAll('.spotlight-card').forEach((card) => {
            card.addEventListener(
              'pointermove',
              (e) => {
                const rect = card.getBoundingClientRect();
                card.style.setProperty('--spot-x', `${e.clientX - rect.left}px`);
                card.style.setProperty('--spot-y', `${e.clientY - rect.top}px`);
              },
              { passive: true },
            );
          });

          // Command Palette (⌘K / Ctrl+K)
          const dialog = document.getElementById('cmd-palette');
          const cmdTrigger = document.getElementById('cmd-trigger');
          const cmdClose = document.getElementById('cmd-close');
          const cmdInput = document.getElementById('cmd-input');
          const cmdItems = Array.from(document.querySelectorAll('[data-cmd-item]'));
          let activeIdx = 0;

          function visibleItems() {
            return cmdItems.filter((el) => !el.hidden);
          }

          function updateSelection(newIdx) {
            const vis = visibleItems();
            if (vis.length === 0) return;
            activeIdx = ((newIdx % vis.length) + vis.length) % vis.length;
            cmdItems.forEach((el) => el.setAttribute('aria-selected', 'false'));
            const current = vis[activeIdx];
            if (current) {
              current.setAttribute('aria-selected', 'true');
              current.scrollIntoView({ block: 'nearest' });
            }
          }

          function openPalette() {
            if (!dialog || typeof dialog.showModal !== 'function') return;
            if (!dialog.open) {
              dialog.showModal();
            }
            if (cmdInput) {
              cmdInput.value = '';
              filterPalette('');
              cmdInput.focus();
            }
          }

          function closePalette() {
            if (dialog && dialog.open) dialog.close();
          }

          function filterPalette(query) {
            const q = query.trim().toLowerCase();
            cmdItems.forEach((item) => {
              const hay = item.getAttribute('data-label') || '';
              item.hidden = q.length > 0 && !hay.includes(q);
            });
            updateSelection(0);
          }

          function executeItem(item) {
            if (!item) return;
            const action = item.getAttribute('data-action');
            const href = item.getAttribute('data-href');
            const payload = item.getAttribute('data-payload');
            closePalette();
            if (action === 'toggle-theme') {
              toggleTheme();
            } else if (action === 'copy-email' && payload) {
              copyText(payload, `Copied ${payload}`);
            } else if (href) {
              window.location.href = href;
            }
          }

          if (cmdTrigger) cmdTrigger.addEventListener('click', openPalette);
          if (cmdClose) cmdClose.addEventListener('click', closePalette);

          if (dialog) {
            dialog.addEventListener('click', (e) => {
              if (e.target === dialog) closePalette();
            });
          }

          if (cmdInput) {
            cmdInput.addEventListener('input', (e) => filterPalette(e.target.value));
          }

          cmdItems.forEach((item) => {
            item.addEventListener('click', () => executeItem(item));
          });

          window.addEventListener('keydown', (e) => {
            if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
              e.preventDefault();
              if (dialog && dialog.open) closePalette();
              else openPalette();
              return;
            }
            if (!dialog || !dialog.open) return;
            if (e.key === 'ArrowDown') {
              e.preventDefault();
              updateSelection(activeIdx + 1);
            } else if (e.key === 'ArrowUp') {
              e.preventDefault();
              updateSelection(activeIdx - 1);
            } else if (e.key === 'Enter') {
              e.preventDefault();
              const vis = visibleItems();
              if (vis[activeIdx]) executeItem(vis[activeIdx]);
            }
          });

          // Lazy-load 2D Embedding Map module when scrolled into view
          const explorer = document.querySelector('[data-embedding-explorer]');
          if (explorer) {
            const loadMap = () => {
              import('/scripts/embedding-map.js')
                .then((m) => m.initEmbeddingMap(explorer))
                .catch(() => {});
            };
            if ('IntersectionObserver' in window) {
              const io = new IntersectionObserver(
                (entries) => {
                  if (entries.some((entry) => entry.isIntersecting)) {
                    io.disconnect();
                    loadMap();
                  }
                },
                { rootMargin: '80px' },
              );
              io.observe(explorer);
            } else {
              loadMap();
            }
          }
        };

        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(init);
        } else {
          setTimeout(init, 1);
        }
      })();
    </script>

    <style>
      .copy-toast {
        position: fixed;
        bottom: var(--space-5);
        right: var(--space-5);
        z-index: 9000;
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-sm);
        background-color: var(--text-primary);
        color: var(--bg-canvas);
        font-size: var(--text-xs);
        box-shadow: var(--shadow-md);
      }
    </style>
  </body>
</html>
