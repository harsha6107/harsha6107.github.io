---
import { Image } from 'astro:assets';
import profileImg from '../assets/profile.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteData } from '../utils/content';

const site = await getSiteData();
---

<BaseLayout
  title="About & Experience Timeline"
  description={`Engineering trajectory, production systems experience, and academic background of ${site.name}, ${site.role}.`}
  ogImage="/og/default.png"
>
  <section class="section">
    <div class="container">
      <span class="section-index">{site.ui.aboutIndex}</span>
      <h1 style="margin-top: var(--space-2);">{site.ui.aboutTitle}</h1>

      <div class="bio-grid" style="margin-top: var(--space-6);">
        <div style="display: flex; flex-direction: column; gap: var(--space-4);">
          {site.aboutShort.map((p) => (
            <p style="font-size: var(--text-lg); color: var(--text-primary); line-height: 1.65;">
              {p}
            </p>
          ))}
          {site.aboutExtended.map((p) => (
            <p style="font-size: var(--text-base); color: var(--text-secondary);">
              {p}
            </p>
          ))}

          <div style="display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-2);">
            <a href="/resume" class="btn btn-primary">
              <span>View Full Résumé</span>
              <span aria-hidden="true" class="mono">→</span>
            </a>
            <a href={site.links.resumePdf} class="btn" download>
              <span>Download PDF</span>
              <span aria-hidden="true" class="mono">↗</span>
            </a>
          </div>
        </div>

        <aside class="profile-card spotlight-card">
          <div class="portrait-wrap">
            <Image
              src={profileImg}
              alt={`${site.name}, ${site.role}`}
              widths={[280, 480]}
              sizes="(max-width: 768px) 240px, 320px"
              format="webp"
              loading="lazy"
              class="portrait-img"
            />
          </div>
          <div style="margin-top: var(--space-4);">
            <p style="font-weight: 600; color: var(--text-primary);">{site.name}</p>
            <p class="mono" style="font-size: var(--text-xs); color: var(--accent); margin-top: 2px;">
              {site.role}
            </p>
            <p style="font-size: var(--text-xs); color: var(--text-muted); margin-top: var(--space-2);">
              M.S. Software Engineering, Carnegie Mellon University · Ex-BlackRock Aladdin
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Experience Timeline -->
  <section class="section" aria-labelledby="timeline-heading">
    <div class="container">
      <span class="section-index">02 / PRODUCTION TRAJECTORY</span>
      <h2 id="timeline-heading" style="margin-top: var(--space-2);">
        Experience Timeline
      </h2>

      <div class="timeline" style="margin-top: var(--space-7);">
        {site.experience.map((exp) => (
          <article class="timeline-item spotlight-card scroll-reveal">
            <div class="timeline-meta">
              <span class="mono" style="font-size: var(--text-xs); color: var(--accent); font-weight: 700;">
                {exp.period}
              </span>
              <h3 style="font-size: var(--text-xl); margin-top: var(--space-1);">
                {exp.company}
              </h3>
              <p class="mono" style="font-size: var(--text-sm); color: var(--text-primary); font-weight: 600; margin-top: 2px;">
                {exp.role}
              </p>
              {exp.product && (
                <p style="font-size: var(--text-xs); color: var(--text-muted); margin-top: 4px;">
                  {exp.product}
                </p>
              )}
              <p class="mono" style="font-size: var(--text-xs); color: var(--text-muted); margin-top: var(--space-2);">
                {exp.location}
              </p>
            </div>

            <div class="timeline-body">
              <p style="font-size: var(--text-base); color: var(--text-primary); font-weight: 500;">
                {exp.summary}
              </p>

              <div class="highlights-stack" style="margin-top: var(--space-4);">
                {exp.highlights.map((h) => (
                  <div class="highlight-row">
                    <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2);">
                      <strong style="font-size: var(--text-sm); color: var(--text-primary);">
                        {h.domain}
                      </strong>
                      <span class="metric-chip">{h.metric}</span>
                    </div>
                    <p style="font-size: var(--text-sm); margin-top: var(--space-2); max-width: 72ch;">
                      {h.text}
                    </p>
                  </div>
                ))}
              </div>

              <ul class="tag-list" style="margin-top: var(--space-4);" aria-label={`${exp.company} stack`}>
                {exp.stack.map((s) => (
                  <li class="tag">{s}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Technical Domains & Education -->
  <section class="section" style="border-bottom: none;" aria-labelledby="domains-heading">
    <div class="container">
      <span class="section-index">03 / CAPABILITY MATRIX &amp; ACADEMIA</span>
      <h2 id="domains-heading" style="margin-top: var(--space-2);">
        Systems Architecture Domains &amp; Education
      </h2>

      <div class="domains-grid" style="margin-top: var(--space-6);">
        {site.skillGroups.map((group) => (
          <div class="spotlight-card scroll-reveal">
            <span class="mono" style="font-size: var(--text-xs); color: var(--accent); font-weight: 700;">
              {group.code}
            </span>
            <h3 style="font-size: var(--text-lg); margin-top: var(--space-1);">
              {group.category}
            </h3>
            <ul style="margin-top: var(--space-3); padding-left: var(--space-4); display: grid; gap: var(--space-2);">
              {group.items.map((item) => (
                <li style="font-size: var(--text-sm);">{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="domains-grid" style="margin-top: var(--space-6);">
        {site.education.map((edu) => (
          <div class="spotlight-card scroll-reveal">
            <span class="mono" style="font-size: var(--text-xs); color: var(--accent); font-weight: 700;">
              EDUCATION // {edu.period}
            </span>
            <h3 style="font-size: var(--text-lg); margin-top: var(--space-1);">
              {edu.institution}
            </h3>
            <p style="font-size: var(--text-sm); color: var(--text-primary); font-weight: 600; margin-top: 4px;">
              {edu.degree} {edu.gpa ? `· GPA ${edu.gpa}` : ''}
            </p>
            <p style="font-size: var(--text-sm); margin-top: var(--space-2);">
              {edu.notes}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .bio-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: start;
  }

  @media (min-width: 54rem) {
    .bio-grid {
      grid-template-columns: 1.6fr 0.9fr;
    }
  }

  .portrait-wrap {
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    aspect-ratio: 4 / 4;
    max-width: 280px;
  }

  .portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.03);
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .profile-card:hover .portrait-img {
    transform: scale(1.03);
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 54rem) {
    .timeline-item {
      grid-template-columns: 16rem 1fr;
    }
  }

  .highlights-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .highlight-row {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    transition:
      transform var(--duration-base) var(--ease-spring),
      border-color var(--duration-base) var(--ease-out);
  }

  .highlight-row:hover {
    transform: translateX(4px);
    border-color: var(--accent);
  }

  .domains-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 48rem) {
    .domains-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
