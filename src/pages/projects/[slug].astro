---
import { type CollectionEntry, render } from 'astro:content';
import ArchitectureDiagram from '../../components/ArchitectureDiagram.astro';
import RetroSprite from '../../components/RetroSprite.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSiteData, getSortedProjects } from '../../utils/content';

export async function getStaticPaths() {
  const projects = await getSortedProjects();
  return projects.map((project, idx) => ({
    params: { slug: project.data.slug },
    props: {
      project,
      prevProject: idx > 0 ? projects[idx - 1] : null,
      nextProject: idx < projects.length - 1 ? projects[idx + 1] : null,
    },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  prevProject: CollectionEntry<'projects'> | null;
  nextProject: CollectionEntry<'projects'> | null;
}

const { project, prevProject, nextProject } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const site = await getSiteData();
---

<BaseLayout
  title={data.title}
  description={data.summary}
  ogImage={`/og/projects/${data.slug}.png`}
  showReadingProgress={true}
>
  <article class="section" style="border-bottom: none;">
    <div class="container">
      <div class="case-topbar">
        <!-- Breadcrumb -->
        <nav aria-label="Breadcrumb" class="pixel" style="font-size: 0.68rem; color: var(--text-muted);">
          <a href="/">OVERWORLD</a>
          <span aria-hidden="true"> / </span>
          <a href="/projects">WORLDS</a>
          <span aria-hidden="true"> / </span>
          <span style="color: var(--accent);">STAGE {data.index}</span>
        </nav>

        <!-- Zelda Quest Mode Lens (Recruiter 60s Summary vs Engineer Full Dungeon) -->
        <div class="audience-toggle pixel" role="group" aria-label={site.ui.audienceLabel}>
          <span class="audience-label" aria-hidden="true">QUEST MODE:</span>
          <div class="audience-seg">
            <button type="button" data-audience-set="recruiter" aria-pressed="false">
              {site.ui.audienceRecruiter}
            </button>
            <button type="button" data-audience-set="engineer" aria-pressed="true">
              {site.ui.audienceEngineer}
            </button>
          </div>
        </div>
      </div>

      <!-- Case Study Stage Cartridge Header (Morphs from ProjectCard via shared view-transition-name) -->
      <header
        class="cartridge-card stage-hero"
        style={`view-transition-name: project-card-${data.slug};`}
      >
        <div class="stage-hero-bar pixel">
          <span style="display: inline-flex; align-items: center; gap: 8px;">
            <RetroSprite name="triforce" size={16} />
            <span>STAGE {data.index} // PRODUCTION SPECIFICATION</span>
          </span>
          <span class="mono" style="font-size: var(--text-xs); color: var(--text-muted);">
            {data.organization} · {data.period}
          </span>
        </div>

        <div style="padding-top: var(--space-4);">
          <span
            class="metric-chip"
            style={`view-transition-name: project-metric-${data.slug};`}
          >
            {data.headlineMetric}
          </span>

          <h1
            style={`margin-top: var(--space-3); view-transition-name: project-title-${data.slug};`}
          >
            {data.title}
          </h1>

          <p class="pixel" style="margin-top: var(--space-2); font-size: 0.72rem; color: var(--accent);">
            PLAYER CLASS: {data.role.toUpperCase()}
          </p>

          <p style="margin-top: var(--space-4); font-size: var(--text-lg); color: var(--text-primary); max-width: 68ch;">
            {data.summary}
          </p>

          <!-- Measured Results Scoreboard -->
          <div class="metrics-panel" style="margin-top: var(--space-6);" aria-label="Measured system outcomes">
            {data.metrics.map((m) => (
              <div class="metric-item">
                <span class="metric-value">{m.value}</span>
                <span class="metric-label" style="font-weight: 700; color: var(--text-secondary);">
                  {m.label}
                </span>
                <span class="metric-label">{m.detail}</span>
              </div>
            ))}
          </div>

          <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4); margin-top: var(--space-5);">
            <ul class="tag-list" aria-label="System stack">
              {data.stack.map((tech) => (
                <li class="tag">{tech}</li>
              ))}
            </ul>

            {data.links.length > 0 && (
              <div style="display: flex; flex-wrap: wrap; gap: var(--space-2);">
                {data.links.map((link) => (
                  <a
                    href={link.href}
                    class="btn btn-icon"
                    target={link.href.startsWith('http') ? '_blank' : undefined}
                    rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  >
                    <span>{link.label}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      </header>

      <!-- Structured Problem & Approach -->
      <div class="spec-grid" style="margin-top: var(--space-7);">
        <section class="spec-box cartridge-card scroll-reveal" aria-labelledby="spec-problem">
          <span class="section-index">BOSS ENCOUNTER // LEGACY BOTTLENECK</span>
          <h2 id="spec-problem" style="font-size: var(--text-lg); margin-top: var(--space-3);">
            Why the Legacy System Failed
          </h2>
          <p style="margin-top: var(--space-3); font-size: var(--text-sm);">
            {data.problem}
          </p>
        </section>

        <section class="spec-box cartridge-card scroll-reveal" aria-labelledby="spec-approach">
          <span class="section-index">WINNING STRATEGY // ARCHITECTURE</span>
          <h2 id="spec-approach" style="font-size: var(--text-lg); margin-top: var(--space-3);">
            Core Engineering Solution
          </h2>
          <p style="margin-top: var(--space-3); font-size: var(--text-sm);">
            {data.approachSummary}
          </p>
        </section>
      </div>

      <!-- Zelda Boss Key Gate when Recruiter Mode is active -->
      <div class="deep-dive-gate cartridge-card" style="margin-top: var(--space-5);">
        <div style="display: flex; align-items: flex-start; gap: var(--space-3);">
          <RetroSprite name="boss-key" size={26} />
          <div>
            <p class="deep-dive-title pixel" style="font-size: 0.8rem;">
              BOSS DOOR LOCKED · {site.ui.deepDiveTitle.toUpperCase()}
            </p>
            <p style="font-size: var(--text-sm); margin-top: var(--space-1);">
              {site.ui.deepDiveBody}
            </p>
          </div>
        </div>
        <button type="button" class="btn btn-primary" data-deep-dive-open>
          <RetroSprite name="boss-key" size={15} />
          <span>{site.ui.deepDiveCta}</span>
          <span aria-hidden="true" class="mono">↓</span>
        </button>
      </div>

      <div id="deep-dive" class="deep-dive" tabindex="-1">
        <section class="spec-box cartridge-card scroll-reveal" style="margin-top: var(--space-5);" aria-labelledby="spec-constraints">
          <span class="section-index">DUNGEON RULES // INVARIANTS</span>
          <h2 id="spec-constraints" style="font-size: var(--text-lg); margin-top: var(--space-3);">
            Non-Negotiable Production Constraints
          </h2>
          <ul style="margin-top: var(--space-3); padding-left: var(--space-5); display: grid; gap: var(--space-2);">
            {data.constraints.map((c) => (
              <li style="font-size: var(--text-sm); max-width: 75ch;">{c}</li>
            ))}
          </ul>
        </section>

        <!-- SVG Architecture Schematic -->
        <section style="margin-top: var(--space-7);" aria-labelledby="spec-diagram">
          <span class="section-index">DUNGEON MAP // SYSTEM SCHEMATIC</span>
          <h2 id="spec-diagram" style="font-size: var(--text-xl); margin-top: var(--space-2);">
            Architecture &amp; Data Flow
          </h2>
          <ArchitectureDiagram
            diagramId={data.diagramId}
            title={data.diagramTitle}
            caption={data.diagramCaption}
          />
        </section>

        <!-- Deep Technical Walkthrough (MDX Content) -->
        <div class="prose" style="margin-top: var(--space-7);">
          <Content />
        </div>

        <!-- Retrospective / Relics Acquired -->
        <section class="spec-box cartridge-card scroll-reveal" style="margin-top: var(--space-8);" aria-labelledby="spec-retro">
          <span class="section-index">STAGE CLEAR // RETROSPECTIVE LOOT</span>
          <h2 id="spec-retro" style="font-size: var(--text-xl); margin-top: var(--space-3);">
            Engineering Lessons &amp; Hardened Guards
          </h2>
          <div class="retro-grid" style="margin-top: var(--space-4);">
            {data.retrospective.map((item, idx) => (
              <div class="retro-card">
                <span class="pixel" style="font-size: 0.66rem; color: var(--accent); display: inline-flex; align-items: center; gap: 6px;">
                  <RetroSprite name="super-star" size={13} />
                  <span>RELIC 0{idx + 1}</span>
                </span>
                <h3 style="font-size: var(--text-base); margin-top: var(--space-2);">
                  {item.title}
                </h3>
                <p style="font-size: var(--text-sm); margin-top: var(--space-2);">
                  {item.detail}
                </p>
              </div>
            ))}
          </div>
        </section>
      </div>

      <!-- Prev / Next Stage Warp -->
      <nav
        aria-label="Case study pagination"
        style="margin-top: var(--space-8); padding-top: var(--space-6); border-top: 2px solid var(--border-subtle); display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-4);"
      >
        {prevProject ? (
          <a href={`/projects/${prevProject.data.slug}`} class="btn">
            <span aria-hidden="true" class="mono">←</span>
            <span>STAGE {prevProject.data.index}: {prevProject.data.shortTitle}</span>
          </a>
        ) : <span />}

        {nextProject ? (
          <a href={`/projects/${nextProject.data.slug}`} class="btn btn-primary">
            <span>NEXT STAGE {nextProject.data.index}: {nextProject.data.shortTitle}</span>
            <span aria-hidden="true" class="mono">→</span>
          </a>
        ) : (
          <a href="/projects" class="btn btn-primary">
            <span>Return to World Select</span>
            <span aria-hidden="true" class="mono">→</span>
          </a>
        )}
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .case-topbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .audience-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.68rem;
  }

  .audience-label {
    color: var(--text-muted);
  }

  .audience-seg {
    display: inline-flex;
    padding: 2px;
    border-radius: var(--radius-xs);
    background-color: var(--bg-subtle);
    border: 2px solid var(--border-strong);
    box-shadow: 2px 2px 0 var(--shadow-color);
  }

  .audience-seg button {
    min-height: 28px;
    padding: 0.2rem 0.65rem;
    border: none;
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    font-family: var(--font-pixel);
    font-size: 0.66rem;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .audience-seg button:hover {
    color: var(--text-primary);
  }

  .audience-seg button[aria-pressed="true"] {
    background-color: var(--accent);
    color: #fffdf7;
    font-weight: 700;
  }

  :global(html[data-theme="dark"]) .audience-seg button[aria-pressed="true"] {
    color: #0b0e1a;
  }

  .stage-hero {
    padding: clamp(1.25rem, 3.5vw, 2.25rem);
    padding-top: 0;
  }

  .stage-hero-bar {
    margin-inline: calc(-1 * clamp(1.25rem, 3.5vw, 2.25rem));
    padding: 0.55rem clamp(1.25rem, 3.5vw, 2.25rem);
    background-color: var(--bg-subtle);
    border-bottom: 2px solid var(--border-strong);
    border-top: 4px solid var(--retro-gold-fill);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    font-size: 0.7rem;
    color: var(--text-primary);
  }

  .deep-dive-gate {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    border-style: dashed;
    border-color: var(--accent);
    background-color: var(--accent-subtle);
  }

  .deep-dive-title {
    color: var(--accent-ink);
  }

  :global(html[data-audience="recruiter"]) .deep-dive {
    display: none;
  }

  :global(html[data-audience="recruiter"]) .deep-dive-gate {
    display: flex;
  }

  .spec-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-5);
  }

  .retro-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-4);
  }

  .retro-card {
    padding: var(--space-4);
    border-radius: var(--radius-xs);
    background-color: var(--bg-subtle);
    border: 1.5px solid var(--border-strong);
    min-width: 0;
    transition:
      transform var(--duration-base) var(--ease-spring),
      border-color var(--duration-base) var(--ease-out);
  }

  .retro-card:hover {
    transform: translate(-2px, -2px);
    border-color: var(--accent);
    box-shadow: 3px 3px 0 var(--shadow-color);
  }
</style>
