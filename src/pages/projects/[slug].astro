---
import { type CollectionEntry, render } from 'astro:content';
import ArchitectureDiagram from '../../components/ArchitectureDiagram.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSiteData, getSortedProjects } from '../../utils/content';

export async function getStaticPaths() {
  const projects = await getSortedProjects();
  return projects.map((project, idx) => ({
    params: { slug: project.data.slug },
    props: {
      project,
      prevProject: idx > 0 ? projects[idx - 1] : null,
      nextProject: idx < projects.length - 1 ? projects[idx + 1] : null,
    },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  prevProject: CollectionEntry<'projects'> | null;
  nextProject: CollectionEntry<'projects'> | null;
}

const { project, prevProject, nextProject } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const site = await getSiteData();
---

<BaseLayout
  title={data.title}
  description={data.summary}
  ogImage={`/og/projects/${data.slug}.png`}
  showReadingProgress={true}
>
  <article class="section" style="border-bottom: none;">
    <div class="container">
      <div class="case-topbar">
        <!-- Breadcrumb -->
        <nav aria-label="Breadcrumb" class="mono" style="font-size: var(--text-xs); color: var(--text-muted);">
          <a href="/">Home</a>
          <span aria-hidden="true"> / </span>
          <a href="/projects">Work</a>
          <span aria-hidden="true"> / </span>
          <span style="color: var(--accent);">SYS.{data.index}</span>
        </nav>

        <div class="audience-toggle mono" role="group" aria-label={site.ui.audienceLabel}>
          <span class="audience-label" aria-hidden="true">{site.ui.audienceLabel}</span>
          <div class="audience-seg">
            <button type="button" data-audience-set="recruiter" aria-pressed="false">
              {site.ui.audienceRecruiter}
            </button>
            <button type="button" data-audience-set="engineer" aria-pressed="true">
              {site.ui.audienceEngineer}
            </button>
          </div>
        </div>
      </div>

      <!-- Case Study Header (Morphs from ProjectCard via shared view-transition-name) -->
      <header
        class="spotlight-card"
        style={`padding: clamp(1.5rem, 3.5vw, 2.5rem); view-transition-name: project-card-${data.slug};`}
      >
        <div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3);">
          <span class="mono" style="font-size: var(--text-xs); font-weight: 700; color: var(--accent);">
            CASE STUDY // SYS.{data.index}
          </span>
          <span
            class="metric-chip"
            style={`view-transition-name: project-metric-${data.slug};`}
          >
            {data.headlineMetric}
          </span>
          <span class="mono" style="font-size: var(--text-xs); color: var(--text-muted); margin-left: auto;">
            {data.organization} · {data.period}
          </span>
        </div>

        <h1
          style={`margin-top: var(--space-4); view-transition-name: project-title-${data.slug};`}
        >
          {data.title}
        </h1>

        <p class="mono" style="margin-top: var(--space-2); font-size: var(--text-sm); color: var(--text-muted);">
          Role: {data.role}
        </p>

        <p style="margin-top: var(--space-4); font-size: var(--text-lg); color: var(--text-primary); max-width: 68ch;">
          {data.summary}
        </p>

        <!-- Measured Results Telemetry Grid -->
        <div class="metrics-panel" style="margin-top: var(--space-6);" aria-label="Measured system outcomes">
          {data.metrics.map((m) => (
            <div class="metric-item">
              <span class="metric-value">{m.value}</span>
              <span class="metric-label" style="font-weight: 600; color: var(--text-secondary);">
                {m.label}
              </span>
              <span class="metric-label">{m.detail}</span>
            </div>
          ))}
        </div>

        <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4); margin-top: var(--space-5);">
          <ul class="tag-list" aria-label="System stack">
            {data.stack.map((tech) => (
              <li class="tag">{tech}</li>
            ))}
          </ul>

          {data.links.length > 0 && (
            <div style="display: flex; flex-wrap: wrap; gap: var(--space-2);">
              {data.links.map((link) => (
                <a
                  href={link.href}
                  class="btn btn-icon"
                  target={link.href.startsWith('http') ? '_blank' : undefined}
                  rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                >
                  <span>{link.label}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          )}
        </div>
      </header>

      <!-- Structured Problem, Constraints & Approach Summary -->
      <div class="spec-grid" style="margin-top: var(--space-7);">
        <section class="spec-box scroll-reveal" aria-labelledby="spec-problem">
          <span class="section-index">01 / PROBLEM STATEMENT</span>
          <h2 id="spec-problem" style="font-size: var(--text-lg); margin-top: var(--space-2);">
            Why the Legacy System Failed
          </h2>
          <p style="margin-top: var(--space-3); font-size: var(--text-sm);">
            {data.problem}
          </p>
        </section>

        <section class="spec-box scroll-reveal" aria-labelledby="spec-approach">
          <span class="section-index">02 / ARCHITECTURAL APPROACH</span>
          <h2 id="spec-approach" style="font-size: var(--text-lg); margin-top: var(--space-2);">
            Core Engineering Solution
          </h2>
          <p style="margin-top: var(--space-3); font-size: var(--text-sm);">
            {data.approachSummary}
          </p>
        </section>
      </div>

      <div class="deep-dive-gate spec-box" style="margin-top: var(--space-5);">
        <div>
          <p class="deep-dive-title">{site.ui.deepDiveTitle}</p>
          <p style="font-size: var(--text-sm); margin-top: var(--space-1);">{site.ui.deepDiveBody}</p>
        </div>
        <button type="button" class="btn btn-primary" data-deep-dive-open>
          <span>{site.ui.deepDiveCta}</span>
          <span aria-hidden="true" class="mono">↓</span>
        </button>
      </div>

      <div id="deep-dive" class="deep-dive" tabindex="-1">
        <section class="spec-box scroll-reveal" style="margin-top: var(--space-5);" aria-labelledby="spec-constraints">
          <span class="section-index">03 / SYSTEM CONSTRAINTS &amp; INVARIANTS</span>
          <h2 id="spec-constraints" style="font-size: var(--text-lg); margin-top: var(--space-2);">
            Non-Negotiable Production Constraints
          </h2>
          <ul style="margin-top: var(--space-3); padding-left: var(--space-5); display: grid; gap: var(--space-2);">
            {data.constraints.map((c) => (
              <li style="font-size: var(--text-sm); max-width: 75ch;">{c}</li>
            ))}
          </ul>
        </section>

        <!-- 04 / SVG Architecture Schematic -->
        <section style="margin-top: var(--space-7);" aria-labelledby="spec-diagram">
          <span class="section-index">04 / SYSTEM SCHEMATIC</span>
          <h2 id="spec-diagram" style="font-size: var(--text-xl); margin-top: var(--space-2);">
            Architecture &amp; Data Flow
          </h2>
          <ArchitectureDiagram
            diagramId={data.diagramId}
            title={data.diagramTitle}
            caption={data.diagramCaption}
          />
        </section>

        <!-- 05 / Deep Technical Walkthrough (MDX Content) -->
        <div class="prose" style="margin-top: var(--space-7);">
          <Content />
        </div>

        <!-- 06 / What I'd Do Differently (Retrospective) -->
        <section class="spec-box scroll-reveal" style="margin-top: var(--space-8);" aria-labelledby="spec-retro">
          <span class="section-index">06 / RETROSPECTIVE</span>
          <h2 id="spec-retro" style="font-size: var(--text-xl); margin-top: var(--space-2);">
            What I Would Do Differently
          </h2>
          <div class="retro-grid" style="margin-top: var(--space-4);">
            {data.retrospective.map((item, idx) => (
              <div class="retro-card">
                <span class="mono" style="font-size: var(--text-xs); color: var(--accent); font-weight: 700;">
                  LESSON 0{idx + 1}
                </span>
                <h3 style="font-size: var(--text-base); margin-top: var(--space-1);">
                  {item.title}
                </h3>
                <p style="font-size: var(--text-sm); margin-top: var(--space-2);">
                  {item.detail}
                </p>
              </div>
            ))}
          </div>
        </section>
      </div>

      <!-- Prev / Next Case Study Navigation -->
      <nav
        aria-label="Case study pagination"
        style="margin-top: var(--space-8); padding-top: var(--space-6); border-top: 1px solid var(--border-subtle); display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-4);"
      >
        {prevProject ? (
          <a href={`/projects/${prevProject.data.slug}`} class="btn">
            <span aria-hidden="true" class="mono">←</span>
            <span>{prevProject.data.index}. {prevProject.data.shortTitle}</span>
          </a>
        ) : <span />}

        {nextProject ? (
          <a href={`/projects/${nextProject.data.slug}`} class="btn">
            <span>{nextProject.data.index}. {nextProject.data.shortTitle}</span>
            <span aria-hidden="true" class="mono">→</span>
          </a>
        ) : (
          <a href="/projects" class="btn">
            <span>All Case Studies</span>
            <span aria-hidden="true" class="mono">→</span>
          </a>
        )}
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .case-topbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .audience-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
  }

  .audience-label {
    color: var(--text-muted);
  }

  .audience-seg {
    display: inline-flex;
    padding: 2px;
    border-radius: var(--radius-sm);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
  }

  .audience-seg button {
    min-height: 26px;
    padding: 0.2rem 0.65rem;
    border: none;
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .audience-seg button:hover {
    color: var(--text-primary);
  }

  .audience-seg button[aria-pressed="true"] {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    font-weight: 600;
    box-shadow: var(--shadow-xs);
  }

  .deep-dive-gate {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    border-style: dashed;
    border-color: var(--border-strong);
  }

  .deep-dive-title {
    font-weight: 600;
    color: var(--text-primary);
  }

  :global(html[data-audience="recruiter"]) .deep-dive {
    display: none;
  }

  :global(html[data-audience="recruiter"]) .deep-dive-gate {
    display: flex;
  }

  .spec-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-5);
  }

  .spec-box {
    position: relative;
    overflow: hidden;
    padding: clamp(1rem, 3vw, 1.5rem);
    border-radius: var(--radius-md);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    min-width: 0;
    transition:
      transform var(--duration-base) var(--ease-spring),
      border-color var(--duration-base) var(--ease-out);
  }

  .spec-box::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      360px circle at var(--spot-x, 50%) var(--spot-y, 50%),
      var(--spotlight-fill),
      transparent 45%
    );
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .spec-box:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
  }

  .spec-box:hover::before {
    opacity: 1;
  }

  .retro-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-4);
  }

  .retro-card {
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    min-width: 0;
    transition:
      transform var(--duration-base) var(--ease-spring),
      border-color var(--duration-base) var(--ease-out);
  }

  .retro-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }
</style>

