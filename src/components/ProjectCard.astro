---
import type { CollectionEntry } from 'astro:content';
import RetroSprite from './RetroSprite.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  readMoreLabel: string;
  headingLevel?: 'h2' | 'h3';
}

const { project, readMoreLabel, headingLevel = 'h3' } = Astro.props;
const { data } = project;
const HeadingTag = headingLevel;

const stageThemes: Record<
  string,
  {
    world: string;
    sprite: 'pacman' | 'triforce' | 'warp-pipe' | 'tetromino-t' | 'super-star';
    stripeClass: string;
  }
> = {
  '01': { world: 'WORLD 1-1', sprite: 'pacman', stripeClass: 'pak-stripe--gold' },
  '02': { world: 'WORLD 1-2', sprite: 'triforce', stripeClass: 'pak-stripe--green' },
  '03': { world: 'WORLD 2-1', sprite: 'warp-pipe', stripeClass: 'pak-stripe--cyan' },
  '04': { world: 'WORLD 2-2', sprite: 'tetromino-t', stripeClass: 'pak-stripe--red' },
  '05': { world: 'STAR-1', sprite: 'super-star', stripeClass: 'pak-stripe--orange' },
};

const theme = stageThemes[data.index] ?? {
  world: `STAGE ${data.index}`,
  sprite: 'cartridge' as const,
  stripeClass: 'pak-stripe--gold',
};
---

<article
  class="cartridge-card game-pak scroll-reveal"
  style={`view-transition-name: project-card-${data.slug};`}
>
  <div class:list={['pak-header', theme.stripeClass]}>
    <div class="pak-world pixel">
      <RetroSprite name={theme.sprite} size={16} />
      <span>{theme.world} // STAGE CLEAR ★</span>
    </div>
    <span class="pak-org mono">{data.organization} · {data.period}</span>
  </div>

  <div class="project-card-grid" style="padding-top: var(--space-4);">
    <div style="display: flex; flex-direction: column; gap: var(--space-3);">
      <div>
        <span
          class="metric-chip"
          style={`view-transition-name: project-metric-${data.slug};`}
        >
          {data.headlineMetric}
        </span>
      </div>

      <HeadingTag
        style={`font-size: var(--text-xl); margin-top: var(--space-1); view-transition-name: project-title-${data.slug};`}
      >
        <a
          href={`/projects/${data.slug}`}
          style="text-decoration: none; display: inline-block;"
        >
          {data.title}
        </a>
      </HeadingTag>

      <p class="pixel" style="font-size: 0.7rem; color: var(--text-muted);">
        CLASS: {data.role.toUpperCase()}
      </p>

      <p style="color: var(--text-secondary); font-size: var(--text-base);">
        {data.summary}
      </p>

      <ul class="tag-list" aria-label="Technology stack" style="margin-top: var(--space-1);">
        {data.stack.map((tech) => (
          <li class="tag">{tech}</li>
        ))}
      </ul>

      <div style="margin-top: var(--space-2);">
        <a
          href={`/projects/${data.slug}`}
          class="btn btn-primary"
          aria-label={`${readMoreLabel}: ${data.title}`}
        >
          <span class="pixel" style="font-size: 0.72rem;"><span aria-hidden="true">▶ </span>{readMoreLabel}</span>
          <span aria-hidden="true" class="mono">→</span>
        </a>
      </div>
    </div>

    <div style="display: flex; flex-direction: column; gap: var(--space-3);">
      <div class="pak-tally-head pixel">
        <span>STAGE SCOREBOARD</span>
        <span>VERIFIED</span>
      </div>
      <div class="metrics-panel" aria-label={`Key metrics for ${data.shortTitle}`}>
        {data.metrics.map((m) => (
          <div class="metric-item">
            <span class="metric-value">{m.value}</span>
            <span class="metric-label" style="font-weight: 700; color: var(--text-secondary);">
              {m.label}
            </span>
            <span class="metric-label">{m.detail}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</article>

<style>
  .game-pak {
    padding-top: 0;
    container-type: inline-size;
  }

  .pak-header {
    margin-inline: calc(-1 * clamp(1rem, 3vw, 1.85rem));
    padding: 0.55rem clamp(1rem, 3vw, 1.85rem);
    background-color: var(--bg-subtle);
    border-bottom: 2px solid var(--border-strong);
    border-top: 4px solid var(--retro-gold-fill);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .pak-stripe--gold {
    border-top-color: var(--retro-gold-fill);
  }
  .pak-stripe--green {
    border-top-color: var(--retro-green-fill);
  }
  .pak-stripe--cyan {
    border-top-color: var(--retro-cyan-fill);
  }
  .pak-stripe--red {
    border-top-color: var(--retro-red-fill);
  }
  .pak-stripe--orange {
    border-top-color: var(--retro-orange-fill);
  }

  .pak-world {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .pak-org {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .pak-tally-head {
    display: flex;
    justify-content: space-between;
    font-size: 0.65rem;
    color: var(--text-muted);
    padding-inline: 2px;
  }
</style>
