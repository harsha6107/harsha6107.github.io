---
import type { CollectionEntry } from 'astro:content';
import RetroSprite from './RetroSprite.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
  posts: CollectionEntry<'writing'>[];
  email: string;
  githubUrl: string;
  linkedinUrl: string;
  resumePdfUrl: string;
  placeholder: string;
  extras: { id: string; label: string; sub: string; action: string; payload: string }[];
  shortcutsLabel: string;
}

const {
  projects,
  posts,
  email,
  githubUrl,
  linkedinUrl,
  resumePdfUrl,
  placeholder,
  extras,
  shortcutsLabel,
} = Astro.props;

type Item = {
  id: string;
  group: string;
  label: string;
  sub: string;
  action?: string;
  payload?: string;
  href?: string;
  kbd?: string;
};

const items: Item[] = [
  {
    id: 'act-quest',
    group: 'Arcade Controls',
    label: 'Open Explorer Quest Log (5 Retro Relics)',
    sub: 'Track discovered artifacts & warp to stages',
    action: 'open-quest',
  },
  {
    id: 'act-sfx',
    group: 'Arcade Controls',
    label: 'Toggle 8-Bit Chiptune SFX',
    sub: 'WebAudio square-wave coin, pellet & secret chimes',
    action: 'toggle-sfx',
    kbd: 'M',
  },
  {
    id: 'act-theme',
    group: 'Arcade Controls',
    label: 'Switch World Theme (Midnight Arcade / Famicom Manual)',
    sub: 'Toggle dark CRT cabinet vs. warm parchment guide',
    action: 'toggle-theme',
    kbd: 'T',
  },
  {
    id: 'act-email',
    group: 'Arcade Controls',
    label: `Copy Email (${email})`,
    sub: 'Copy direct address to clipboard',
    action: 'copy-email',
    payload: email,
    kbd: 'C',
  },
  {
    id: 'act-resume',
    group: 'Arcade Controls',
    label: 'Download Save File (Résumé PDF)',
    sub: 'Harsha_Tummala.pdf',
    href: resumePdfUrl,
  },
  {
    id: 'act-shortcuts',
    group: 'Arcade Controls',
    label: shortcutsLabel,
    sub: 'G H · G W · G N · G A · G R · T · M · C · / · ↑↑↓↓←→←→BA',
    action: 'shortcuts',
    kbd: '?',
  },
  ...extras.map((x) => ({
    id: x.id,
    group: 'Secret Codes',
    label: x.label,
    sub: x.sub,
    action: x.action,
    payload: x.payload,
  })),
  {
    id: 'nav-home',
    group: 'Warp Zones',
    label: 'Home — World Select, Pac-Search, Overworld & Tetris Stack',
    sub: '/',
    href: '/',
  },
  {
    id: 'nav-projects',
    group: 'Warp Zones',
    label: 'Work — All 5 Production World Stages (Case Studies)',
    sub: '/projects',
    href: '/projects',
  },
  {
    id: 'nav-writing',
    group: 'Warp Zones',
    label: 'Writing — Strategy Scrolls & Architecture Notes',
    sub: '/writing',
    href: '/writing',
  },
  {
    id: 'nav-about',
    group: 'Warp Zones',
    label: 'About — Player 1 Character Sheet & Quest Timeline',
    sub: '/about',
    href: '/about',
  },
  {
    id: 'nav-resume-page',
    group: 'Warp Zones',
    label: 'Résumé — Official Cartridge Specification',
    sub: '/resume',
    href: '/resume',
  },
  ...projects.map((p) => ({
    id: `proj-${p.data.slug}`,
    group: 'World Stages (Case Studies)',
    label: `${p.data.index}. ${p.data.title}`,
    sub: p.data.headlineMetric,
    href: `/projects/${p.data.slug}`,
  })),
  ...posts.map((post) => ({
    id: `post-${post.data.slug}`,
    group: 'Field Manuals (Technical Writing)',
    label: post.data.title,
    sub: `${post.data.category} · ${post.data.readingTime}`,
    href: `/writing/${post.data.slug}`,
  })),
  {
    id: 'ext-github',
    group: 'External Guilds',
    label: 'GitHub — @harsha6107',
    sub: githubUrl,
    href: githubUrl,
  },
  {
    id: 'ext-linkedin',
    group: 'External Guilds',
    label: 'LinkedIn — Harsha Tummala',
    sub: linkedinUrl,
    href: linkedinUrl,
  },
];
---

<dialog
  id="cmd-palette"
  class="cmd-dialog"
  aria-label="Warp Whistle Command Palette"
>
  <div class="cmd-surface">
    <div class="cmd-banner pixel">
      <span><RetroSprite name="super-star" size={14} /> WARP WHISTLE // SELECT DESTINATION</span>
      <span>⌘K</span>
    </div>

    <div class="cmd-header">
      <label for="cmd-input" class="sr-only">{placeholder}</label>
      <span class="pixel" style="color: var(--accent); font-size: var(--text-sm);" aria-hidden="true">▶</span>
      <input
        id="cmd-input"
        type="text"
        class="cmd-input"
        placeholder={placeholder}
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="cmd-listbox"
        aria-autocomplete="list"
      />
      <button
        type="button"
        id="cmd-close"
        class="btn btn-icon"
        aria-label="Close command palette"
      >
        ESC
      </button>
    </div>

    <ul
      id="cmd-listbox"
      class="cmd-list"
      role="listbox"
      aria-label="Warp destinations and arcade commands"
    >
      {items.map((item, idx) => (
        <li
          id={item.id}
          role="option"
          aria-selected={idx === 0 ? 'true' : 'false'}
          class="cmd-option"
          data-cmd-item
          data-label={`${item.group} ${item.label} ${item.sub}`.toLowerCase()}
          data-href={item.href ?? ''}
          data-action={item.action ?? ''}
          data-payload={item.payload ?? ''}
          tabindex="-1"
        >
          <div style="display: flex; flex-direction: column; gap: 2px; min-width: 0;">
            <span class="pixel" style="font-size: 0.64rem; color: var(--accent);">
              {item.group}
            </span>
            <span style="font-size: var(--text-sm); font-weight: 600; color: var(--text-primary);">
              {item.label}
            </span>
            <span class="mono" style="font-size: var(--text-xs); color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
              {item.sub}
            </span>
          </div>
          {item.kbd && <kbd class="kbd-badge">{item.kbd}</kbd>}
        </li>
      ))}
    </ul>

    <div class="cmd-footer pixel">
      <span>↑↓ SELECT</span>
      <span>↵ WARP</span>
      <span>ESC EXIT</span>
    </div>
  </div>
</dialog>

<style>
  .cmd-dialog {
    margin: clamp(3rem, 10vh, 7rem) auto auto;
    width: min(92vw, 40rem);
    border: 3px solid var(--border-strong);
    border-radius: var(--radius-md);
    background-color: var(--bg-surface);
    color: var(--text-primary);
    box-shadow: var(--shadow-dialog);
    padding: 0;
    overflow: hidden;
  }

  .cmd-dialog::backdrop {
    background-color: rgba(8, 10, 18, 0.72);
    backdrop-filter: blur(3px);
  }

  .cmd-surface {
    display: flex;
    flex-direction: column;
    max-height: 78dvh;
  }

  .cmd-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: 0.45rem var(--space-4);
    background-color: var(--bg-subtle);
    border-bottom: 2px solid var(--border-strong);
    font-size: 0.68rem;
    color: var(--text-secondary);
  }

  .cmd-banner > span:first-child {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .cmd-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 2px solid var(--border-subtle);
  }

  .cmd-input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: var(--text-base);
    color: var(--text-primary);
    outline: none;
  }

  .cmd-list {
    list-style: none;
    overflow-y: auto;
    padding: var(--space-2);
    max-height: 22rem;
  }

  .cmd-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-xs);
    border: 1.5px solid transparent;
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .cmd-option[aria-selected="true"],
  .cmd-option:hover {
    background-color: var(--bg-subtle);
    border-color: var(--accent);
  }

  .cmd-option[hidden] {
    display: none !important;
  }

  .cmd-footer {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-4);
    border-top: 2px solid var(--border-strong);
    background-color: var(--bg-subtle);
    font-size: 0.66rem;
    color: var(--text-muted);
  }
</style>
