---
import type { CollectionEntry } from 'astro:content';
import RetroSprite from './RetroSprite.astro';

interface SkillNode {
  id: string;
  label: string;
  cluster: 'search' | 'agents' | 'data' | 'ml';
  x: number;
  y: number;
  vector: number[];
  detail: string;
  relatedProjectSlug: string;
}

interface Props {
  projects: CollectionEntry<'projects'>[];
  posts: CollectionEntry<'writing'>[];
  skillNodes: SkillNode[];
  sectionIndex: string;
  title: string;
  subtitle: string;
}

const { projects, posts, skillNodes, title, subtitle } = Astro.props;

interface MapPoint {
  id: string;
  label: string;
  kind: 'project' | 'essay' | 'skill';
  cluster: 'search' | 'agents' | 'data' | 'ml';
  x: number;
  y: number;
  vector: number[];
  summary: string;
  href: string;
  metricBadge: string;
}

const points: MapPoint[] = [
  ...projects.map((p) => ({
    id: `proj-${p.data.slug}`,
    label: p.data.shortTitle,
    kind: 'project' as const,
    cluster: p.data.embedding.cluster,
    x: p.data.embedding.x,
    y: p.data.embedding.y,
    vector: p.data.embedding.vector,
    summary: p.data.summary,
    href: `/projects/${p.data.slug}`,
    metricBadge: p.data.headlineMetric,
  })),
  ...posts.map((post) => ({
    id: `post-${post.data.slug}`,
    label: post.data.title.split(':')[0] ?? post.data.title,
    kind: 'essay' as const,
    cluster: post.data.embedding.cluster,
    x: post.data.embedding.x,
    y: post.data.embedding.y,
    vector: post.data.embedding.vector,
    summary: post.data.summary,
    href: `/writing/${post.data.slug}`,
    metricBadge: `Field Log · ${post.data.readingTime}`,
  })),
  ...skillNodes.map((s) => ({
    id: s.id,
    label: s.label,
    kind: 'skill' as const,
    cluster: s.cluster,
    x: s.x,
    y: s.y,
    vector: s.vector,
    summary: s.detail,
    href: `/projects/${s.relatedProjectSlug}`,
    metricBadge: `Warp → /projects/${s.relatedProjectSlug}`,
  })),
];

const clusterMeta = [
  { id: 'all', label: 'All Worlds (18)' },
  { id: 'search', label: 'W1: Search Island' },
  { id: 'agents', label: 'W2: Agent Citadel' },
  { id: 'data', label: 'W3: CDC Pipeworks' },
  { id: 'ml', label: 'W4: Star Peaks' },
];

function cosineSimilarity(a: number[], b: number[]): number {
  let dot = 0;
  let normA = 0;
  let normB = 0;
  for (let i = 0; i < a.length; i++) {
    const va = a[i] ?? 0;
    const vb = b[i] ?? 0;
    dot += va * vb;
    normA += va * va;
    normB += vb * vb;
  }
  const denom = Math.sqrt(normA) * Math.sqrt(normB);
  return denom === 0 ? 0 : dot / denom;
}

const initialSource = points[0];
const initialNeighbors = initialSource
  ? points
      .filter((pt) => pt.id !== initialSource.id)
      .map((pt) => ({
        point: pt,
        score: cosineSimilarity(initialSource.vector, pt.vector),
      }))
      .sort((a, b) => b.score - a.score)
      .slice(0, 3)
  : [];
---

<section id="latent-space" class="section scroll-reveal" aria-labelledby="latent-space-heading">
  <div class="container">
    <div class="section-header">
      <div>
        <span class="section-index">STAGE 03 // SUPER OVERWORLD LATENT MAP</span>
        <h2 id="latent-space-heading" style="margin-top: var(--space-2);">{title}</h2>
        <p style="margin-top: var(--space-2);">{subtitle}</p>
      </div>
      <div class="cluster-pills" role="toolbar" aria-label="Filter overworld biomes">
        {clusterMeta.map((c, idx) => (
          <button
            type="button"
            class="btn btn-icon cluster-btn"
            data-cluster-filter={c.id}
            aria-pressed={idx === 0 ? 'true' : 'false'}
          >
            {c.label}
          </button>
        ))}
      </div>
    </div>

    <div
      class="embedding-explorer"
      data-embedding-explorer
      data-points={JSON.stringify(points)}
    >
      <div class="embedding-canvas-wrap">
        <div class="overworld-topbar pixel">
          <span><RetroSprite name="super-star" size={14} /> DINOSAUR-STYLE 2D UMAP OVERWORLD</span>
          <span>k=3 COSINE WARP ROADS</span>
        </div>

        <svg
          class="embedding-svg"
          viewBox="0 0 1000 540"
          role="group"
          aria-label="Interactive Overworld Embedding Map of Projects, Field Logs, and Production Capabilities"
        >
          <!-- Overworld Ocean Backdrop -->
          <rect width="1000" height="540" class="ow-sea" />

          <!-- Decorative Overworld Sea Waves -->
          <g class="ow-waves" aria-hidden="true">
            <path d="M465 90h24M480 265h30M468 445h28M30 268h22M940 268h24" stroke-width="3" stroke-linecap="square" />
          </g>

          <!-- Wooden Overworld Bridges & Central Star Road Warp -->
          <g aria-hidden="true">
            <!-- Horizontal Upper Bridge (W1 <-> W2) -->
            <rect x="448" y="142" width="72" height="14" fill="#B87400" stroke="#141724" stroke-width="2" />
            <path d="M460 142v14M472 142v14M484 142v14M496 142v14M508 142v14" stroke="#141724" stroke-width="1.5" />
            <!-- Horizontal Lower Bridge (W3 <-> W4) -->
            <rect x="448" y="394" width="72" height="14" fill="#B87400" stroke="#141724" stroke-width="2" />
            <path d="M460 394v14M472 394v14M484 394v14M496 394v14M508 394v14" stroke="#141724" stroke-width="1.5" />
            <!-- Left Vertical Bridge (W1 <-> W3) -->
            <rect x="232" y="256" width="14" height="38" fill="#B87400" stroke="#141724" stroke-width="2" />
            <path d="M232 265h14M232 275h14M232 285h14" stroke="#141724" stroke-width="1.5" />
            <!-- Right Vertical Bridge (W2 <-> W4) -->
            <rect x="738" y="256" width="14" height="38" fill="#B87400" stroke="#141724" stroke-width="2" />
            <path d="M738 265h14M738 275h14M738 285h14" stroke="#141724" stroke-width="1.5" />
            <!-- Central Star Road Atoll -->
            <rect x="466" y="257" width="36" height="34" rx="6" fill="#FFE885" stroke="#141724" stroke-width="2" />
            <use href="#sp-super-star" x="474" y="264" width="20" height="20" />
          </g>

          <!-- WORLD 1: SEARCH & RAG GRASSLANDS (Top-Left) -->
          <g aria-hidden="true">
            <rect x="28" y="42" width="420" height="214" rx="14" class="ow-island ow-island--w1" />
            <rect x="38" y="50" width="400" height="196" rx="10" class="ow-island-inner" />
            <!-- Pixel Warp Pipe & Hill Landmark -->
            <rect x="398" y="64" width="24" height="8" fill="#2BC46D" stroke="#141724" stroke-width="2" />
            <rect x="401" y="72" width="18" height="16" fill="#2BC46D" stroke="#141724" stroke-width="2" />
            <text x="52" y="74" class="pixel ow-world-title">WORLD 1 · SEARCH &amp; RAG VALLEY</text>
          </g>

          <!-- WORLD 2: AGENTIC AI & MCP CITADEL (Top-Right) -->
          <g aria-hidden="true">
            <rect x="520" y="42" width="452" height="214" rx="14" class="ow-island ow-island--w2" />
            <rect x="530" y="50" width="432" height="196" rx="10" class="ow-island-inner" />
            <!-- Pixel Fortress Turrets Landmark -->
            <path d="M922 62h8v8h6v-8h8v24h-22V62z" fill="#FFD23F" stroke="#141724" stroke-width="2" />
            <text x="546" y="74" class="pixel ow-world-title">WORLD 2 · AGENTIC AI &amp; MCP CITADEL</text>
          </g>

          <!-- WORLD 3: STREAMING CDC PIPEWORKS (Bottom-Left) -->
          <g aria-hidden="true">
            <rect x="28" y="294" width="420" height="214" rx="14" class="ow-island ow-island--w3" />
            <rect x="38" y="302" width="400" height="196" rx="10" class="ow-island-inner" />
            <!-- Twin Snowflake Pipe Landmark -->
            <rect x="398" y="314" width="24" height="20" fill="#4CE0F4" stroke="#141724" stroke-width="2" />
            <text x="52" y="326" class="pixel ow-world-title">WORLD 3 · CDC &amp; SNOWFLAKE PIPEWORKS</text>
          </g>

          <!-- WORLD 4: PERCEPTION STAR PEAKS (Bottom-Right) -->
          <g aria-hidden="true">
            <rect x="520" y="294" width="452" height="214" rx="14" class="ow-island ow-island--w4" />
            <rect x="530" y="302" width="432" height="196" rx="10" class="ow-island-inner" />
            <!-- Star Peak Landmark -->
            <polygon points="934,312 946,336 922,336" fill="#FFA94D" stroke="#141724" stroke-width="2" />
            <text x="546" y="326" class="pixel ow-world-title">WORLD 4 · ETIM VISION, ASR &amp; IoT PEAKS</text>
          </g>

          <!-- Dynamic k-NN Overworld Dotted Travel Paths -->
          <g id="knn-edges-layer" aria-hidden="true">
            {initialSource && initialNeighbors.map((nb) => (
              <line
                x1={Math.round(initialSource.x * 10)}
                y1={Math.round(initialSource.y * 5.4)}
                x2={Math.round(nb.point.x * 10)}
                y2={Math.round(nb.point.y * 5.4)}
                stroke="var(--accent)"
                stroke-width="3"
                stroke-dasharray="6 6"
                stroke-linecap="square"
              />
            ))}
          </g>

          <!-- Interactive Overworld Stage Nodes -->
          {points.map((pt) => {
            const cx = Math.round(pt.x * 10);
            const cy = Math.round(pt.y * 5.4);
            const isProject = pt.kind === 'project';
            const isEssay = pt.kind === 'essay';
            const size = isProject ? 20 : isEssay ? 15 : 12;
            const half = size / 2;
            return (
              <g
                class="umap-node-group"
                data-node-id={pt.id}
                data-cluster={pt.cluster}
                data-cx={cx}
                data-cy={cy}
              >
                <a
                  href={pt.href}
                  class="umap-node-link"
                  data-node-trigger={pt.id}
                  aria-label={`${pt.kind.toUpperCase()}: ${pt.label} (${pt.metricBadge}) — Open ${pt.href}`}
                >
                  {isProject && (
                    <rect
                      x={cx - half - 5}
                      y={cy - half - 5}
                      width={size + 10}
                      height={size + 10}
                      rx="2"
                      fill="none"
                      stroke="var(--accent)"
                      stroke-width="2"
                      stroke-dasharray="4 2"
                      class="umap-pulse-ring"
                    />
                  )}
                  <rect
                    x={cx - half}
                    y={cy - half}
                    width={size}
                    height={size}
                    rx="2"
                    class:list={[
                      'stage-tile',
                      isProject && 'stage-tile--project',
                      isEssay && 'stage-tile--essay',
                      !isProject && !isEssay && 'stage-tile--skill',
                    ]}
                  />
                  {isProject && (
                    <rect
                      x={cx - 3}
                      y={cy - 3}
                      width="6"
                      height="6"
                      fill="#141724"
                    />
                  )}
                  <text
                    x={cx + half + 7}
                    y={cy + 4}
                    fill="var(--text-primary)"
                    font-size={isProject ? '12.5' : '11'}
                    font-weight={isProject ? '700' : '600'}
                    class="mono umap-label"
                  >
                    {pt.label}
                  </text>
                </a>
              </g>
            );
          })}

          <!-- Animated Player 1 Overworld Walker -->
          {initialSource && (
            <g
              id="ow-player-walker"
              class="ow-walker"
              style={`transform: translate(${Math.round(initialSource.x * 10)}px, ${Math.round(initialSource.y * 5.4)}px);`}
              aria-hidden="true"
            >
              <rect x="-13" y="-34" width="26" height="12" rx="2" fill="#FFD23F" stroke="#141724" stroke-width="1.5" />
              <text x="0" y="-25" text-anchor="middle" fill="#141724" font-size="8" font-weight="700" class="pixel">P1</text>
              <use href="#sp-p1-walker" x="-11" y="-22" width="22" height="22" />
            </g>
          )}

          <!-- Axis Legend Footer inside Map -->
          <text x="28" y="528" fill="var(--text-muted)" font-size="10.5" class="mono">
            UMAP LATENT COORDINATES · HOVER OR FOCUS ANY STAGE TILE TO TRACE k=3 COSINE WARP PATHS
          </text>
        </svg>

        <div class="embedding-legend mono">
          <span><i class="legend-tile legend-tile--project"></i> Fortress Stage (Case Study)</span>
          <span><i class="legend-tile legend-tile--essay"></i> Info Block (Field Essay)</span>
          <span><i class="legend-tile legend-tile--skill"></i> Star Road Node (Capability)</span>
        </div>
      </div>

      <!-- Stage Select HUD Inspector -->
      <aside class="embedding-inspector cartridge-card" aria-live="polite">
        <div class="inspector-header pixel">
          <span>STAGE SELECT HUD</span>
          <span id="emb-kind-badge" class="metric-chip">PROJECT</span>
        </div>

        <h3 id="emb-title" style="font-size: var(--text-lg); margin-top: var(--space-3);">
          {points[0]?.label}
        </h3>

        <p id="emb-metric" class="mono" style="font-size: var(--text-xs); color: var(--accent); font-weight: 700; margin-top: var(--space-1);">
          {points[0]?.metricBadge}
        </p>

        <p id="emb-summary" style="font-size: var(--text-sm); margin-top: var(--space-3);">
          {points[0]?.summary}
        </p>

        <div class="inspector-vector mono">
          <span class="pixel" style="color: var(--text-muted); font-size: 0.64rem;">4D VECTOR [SEARCH, AGENT, DATA, ML]:</span>
          <code id="emb-vector" style="font-size: var(--text-xs); color: var(--text-primary);">
            [{points[0]?.vector.map((v) => v.toFixed(2)).join(', ')}]
          </code>
        </div>

        <div style="margin-top: var(--space-4);">
          <p class="pixel" style="font-size: 0.66rem; color: var(--text-muted);">
            NEAREST WARP PATHS (k=3 COSINE)
          </p>
          <ul id="emb-neighbors" class="neighbor-list mono">
            {initialNeighbors.map((nb) => (
              <li data-neighbor-id={nb.point.id}>
                <span>{nb.point.label}</span>
                <span style="color: var(--accent); font-weight: 700;">cos θ = {nb.score.toFixed(3)}</span>
              </li>
            ))}
          </ul>
        </div>

        <div style="margin-top: auto; padding-top: var(--space-4);">
          <a id="emb-cta" href={points[0]?.href} class="btn btn-primary" style="width: 100%;">
            <span>Enter Stage Specification</span>
            <span aria-hidden="true" class="mono">→</span>
          </a>
        </div>
      </aside>
    </div>

    <!-- Accessible Static Fallback Summary for Screen Readers / No-JS -->
    <details class="static-fallback-details">
      <summary class="pixel" style="font-size: 0.7rem; color: var(--text-secondary); cursor: pointer; padding-block: var(--space-2);">
        ▶ OPEN WORLD MAP LEDGER (ALL 18 STAGES &amp; CAPABILITIES)
      </summary>
      <div style="overflow-x: auto; margin-top: var(--space-3);">
        <table style="width: 100%; border-collapse: collapse; font-size: var(--text-sm);">
          <thead>
            <tr style="border-bottom: 2px solid var(--border-strong); text-align: left;" class="pixel">
              <th style="padding: var(--space-2);">Stage</th>
              <th style="padding: var(--space-2);">Type</th>
              <th style="padding: var(--space-2);">World</th>
              <th style="padding: var(--space-2);">Clear Metric / Warp</th>
            </tr>
          </thead>
          <tbody>
            {points.map((pt) => (
              <tr style="border-bottom: 1px solid var(--border-subtle);">
                <td style="padding: var(--space-2); font-weight: 700;">
                  <a href={pt.href}>{pt.label}</a>
                </td>
                <td style="padding: var(--space-2);" class="mono">{pt.kind}</td>
                <td style="padding: var(--space-2);" class="mono">{pt.cluster}</td>
                <td style="padding: var(--space-2); color: var(--text-secondary);">{pt.metricBadge}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  </div>
</section>

<style>
  .cluster-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .cluster-btn[aria-pressed="true"] {
    background-color: var(--accent);
    color: #fffdf7;
    border-color: var(--border-frame);
  }

  :global(html[data-theme="dark"]) .cluster-btn[aria-pressed="true"] {
    color: #0b0e1a;
  }

  .embedding-explorer {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    align-items: stretch;
  }

  @media (min-width: 60rem) {
    .embedding-explorer {
      grid-template-columns: 1.72fr 1fr;
    }
  }

  .embedding-canvas-wrap {
    background-color: var(--bg-surface);
    border: 2px solid var(--border-strong);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    box-shadow: var(--bevel-highlight), var(--shadow-sm);
    overflow-x: auto;
  }

  .overworld-topbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-bottom: var(--space-2);
    font-size: 0.68rem;
    color: var(--text-secondary);
  }

  .overworld-topbar > span:first-child {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .embedding-svg {
    width: 100%;
    height: auto;
    min-width: 580px;
    border-radius: var(--radius-sm);
    border: 2px solid var(--border-strong);
  }

  .ow-sea {
    fill: #dcebfb;
  }

  :global(html[data-theme="dark"]) .ow-sea {
    fill: #091224;
  }

  .ow-waves {
    stroke: #9ec5ef;
  }

  :global(html[data-theme="dark"]) .ow-waves {
    stroke: #1b3158;
  }

  .ow-island {
    stroke: var(--border-strong);
    stroke-width: 2.5px;
  }

  .ow-island--w1 {
    fill: #cbeed9;
  }
  .ow-island--w2 {
    fill: #f9e6b3;
  }
  .ow-island--w3 {
    fill: #cde5fa;
  }
  .ow-island--w4 {
    fill: #f9d8c5;
  }

  :global(html[data-theme="dark"]) .ow-island--w1 {
    fill: #102a22;
  }
  :global(html[data-theme="dark"]) .ow-island--w2 {
    fill: #272214;
  }
  :global(html[data-theme="dark"]) .ow-island--w3 {
    fill: #112238;
  }
  :global(html[data-theme="dark"]) .ow-island--w4 {
    fill: #291a1c;
  }

  .ow-island-inner {
    fill: none;
    stroke: var(--border-subtle);
    stroke-width: 1.5px;
    stroke-dasharray: 5 4;
  }

  .ow-world-title {
    font-size: 10.5px;
    fill: var(--accent);
    font-weight: 700;
  }

  .ow-walker {
    pointer-events: none;
    transition: transform 280ms var(--ease-spring);
  }

  .umap-node-group {
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .umap-node-group[data-dimmed="true"] {
    opacity: 0.2;
  }

  .embedding-svg[data-hovering="true"] .umap-node-group[data-unrelated="true"] {
    opacity: 0.34;
  }

  .umap-node-link {
    cursor: pointer;
    outline: none;
  }

  .stage-tile {
    stroke: #141724;
    stroke-width: 2px;
    transition: transform var(--duration-base) var(--ease-spring);
    transform-box: fill-box;
    transform-origin: center;
  }

  .stage-tile--project {
    fill: #ffd23f;
  }

  .stage-tile--essay {
    fill: #ff8585;
  }

  .stage-tile--skill {
    fill: #3ee084;
  }

  .umap-node-link:hover .stage-tile,
  .umap-node-link:focus-visible .stage-tile,
  .umap-node-group[data-selected="true"] .stage-tile,
  .umap-node-group[data-highlighted="true"] .stage-tile {
    transform: scale(1.28);
    stroke: #ffffff;
  }

  :global(html[data-theme="light"]) .umap-node-link:focus-visible .stage-tile {
    stroke: #b42318;
    stroke-width: 3px;
  }

  .umap-label {
    paint-order: stroke;
    stroke: var(--bg-surface);
    stroke-width: 4px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .umap-node-group[data-selected="true"] .umap-label,
  .umap-node-link:hover .umap-label {
    fill: var(--accent);
  }

  .embedding-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .legend-tile {
    display: inline-block;
    width: 11px;
    height: 11px;
    border: 1.5px solid #141724;
    margin-right: 6px;
    vertical-align: -1px;
  }

  .legend-tile--project {
    background-color: #ffd23f;
  }

  .legend-tile--essay {
    background-color: #ff8585;
  }

  .legend-tile--skill {
    background-color: #3ee084;
  }

  .embedding-inspector {
    display: flex;
    flex-direction: column;
  }

  .inspector-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .inspector-vector {
    margin-top: var(--space-4);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-xs);
    background-color: var(--bg-subtle);
    border: 1.5px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .neighbor-list {
    list-style: none;
    margin-top: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-xs);
  }

  .neighbor-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: 0.35rem 0.55rem;
    border-radius: var(--radius-xs);
    background-color: var(--bg-subtle);
    border: 1.5px solid var(--border-subtle);
    color: var(--text-secondary);
    transition:
      transform var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

