      <!-- Snowflake Bronze & Siemens Share -->
      <rect x="512" y="30" width="352" height="240" rx="6" fill="var(--bg-subtle)" stroke="var(--accent)" stroke-width="1.75" />
      <text x="528" y="54" fill="var(--accent)" font-size="10" font-weight="700">03 / SNOWFLAKE BRONZE (493 TABLES) &amp; SIEMENS SHARE</text>

      <rect x="528" y="70" width="320" height="88" rx="4" fill="var(--bg-surface)" stroke="var(--border-strong)" />
      <text x="542" y="92" fill="var(--text-primary)" font-size="11" font-weight="700">Batched Micro-Drain MERGEs (-95% Compute Spend)</text>
      <text x="542" y="110" fill="var(--text-secondary)" font-size="10">• Replaced 48 credits/day always-on per-record MERGEs</text>
      <text x="542" y="126" fill="var(--text-secondary)" font-size="10">• QUALIFY ROW_NUMBER() LSN compaction (500K+ rows/run)</text>
