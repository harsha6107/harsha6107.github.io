          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--accent)" />
        </marker>
      </defs>

      <!-- Source SQL Server -->
      <rect x="16" y="30" width="176" height="240" rx="6" fill="var(--bg-subtle)" stroke="var(--border-strong)" stroke-width="1.5" />
      <text x="30" y="54" fill="var(--accent)" font-size="10" font-weight="700">01 / OLTP SOURCE</text>
