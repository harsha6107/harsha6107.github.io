---
interface Props {
  diagramId: 'catalog-search' | 'agentic-mcp' | 'cdc-snowflake' | 'rag-etim' | 'iot-asr';
  title: string;
  caption: string;
}

const { diagramId, title, caption } = Astro.props;
---

<figure class="arch-frame scroll-reveal">
  {diagramId === 'catalog-search' && (
    <svg
      viewBox="0 0 880 310"
      role="img"
      aria-labelledby="diag-catalog-title diag-catalog-desc"
      style="width: 100%; height: auto; min-width: 580px; font-family: var(--font-mono);"
    >
      <title id="diag-catalog-title">{title}</title>
      <desc id="diag-catalog-desc">{caption}</desc>
      <defs>
        <marker id="arrow-cs" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--accent)" />
        </marker>
      </defs>

      <!-- Stage 1: Source & Outbox -->
      <rect x="16" y="28" width="180" height="115" rx="6" fill="var(--bg-subtle)" stroke="var(--border-strong)" stroke-width="1.5" />
      <text x="30" y="52" fill="var(--accent)" font-size="10" font-weight="700">01 / SOURCE &amp; OUTBOX</text>
      <text x="30" y="74" fill="var(--text-primary)" font-size="12" font-weight="600">PostgreSQL + PIMS</text>
      <text x="30" y="94" fill="var(--text-secondary)" font-size="10">• 26M Active SKUs</text>
      <text x="30" y="110" fill="var(--text-secondary)" font-size="10">• Keyset (ts, sku_id)</text>
      <text x="30" y="126" fill="var(--text-secondary)" font-size="10">• 15-min Delta Watermark</text>

      <rect x="16" y="165" width="180" height="115" rx="6" fill="var(--bg-subtle)" stroke="var(--border-subtle)" stroke-width="1.2" />
      <text x="30" y="189" fill="var(--text-muted)" font-size="10" font-weight="700">EVENT SYNC BUS</text>
      <text x="30" y="211" fill="var(--text-primary)" font-size="12" font-weight="600">Azure Service Bus</text>
      <text x="30" y="231" fill="var(--text-secondary)" font-size="10">• Transactional Outbox</text>
      <text x="30" y="247" fill="var(--text-secondary)" font-size="10">• Field-Level Ownership</text>
      <text x="30" y="263" fill="var(--text-secondary)" font-size="10">• Partial Doc Upserts</text>

      <!-- Connectors to Stage 2 -->
      <path d="M 196 85 L 244 85" stroke="var(--accent)" stroke-width="1.75" marker-end="url(#arrow-cs)" />
      <path d="M 196 220 L 220 220 L 220 115 L 244 115" stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="4 3" marker-end="url(#arrow-cs)" />

      <!-- Stage 2: Bounded Bulk Workers -->
      <rect x="248" y="28" width="196" height="252" rx="6" fill="var(--bg-subtle)" stroke="var(--border-strong)" stroke-width="1.5" />
      <text x="264" y="52" fill="var(--accent)" font-size="10" font-weight="700">02 / BOUNDED INGESTION</text>
      <text x="264" y="74" fill="var(--text-primary)" font-size="12" font-weight="600">.NET Sync Workers (2x)</text>
      <rect x="264" y="90" width="164" height="54" rx="4" fill="var(--bg-surface)" stroke="var(--border-subtle)" />
      <text x="274" y="110" fill="var(--text-primary)" font-size="10" font-weight="600">Dual Payload Guard</text>
      <text x="274" y="128" fill="var(--text-secondary)" font-size="10">≤ 1,000 docs | ≤ 5 MB</text>

      <rect x="264" y="156" width="164" height="54" rx="4" fill="var(--bg-surface)" stroke="var(--border-subtle)" />
      <text x="274" y="176" fill="var(--text-primary)" font-size="10" font-weight="600">Count-Verified Swap</text>
      <text x="274" y="194" fill="var(--text-secondary)" font-size="10">Blue/Green Alias Gate</text>

      <rect x="264" y="220" width="164" height="44" rx="4" fill="var(--bg-surface)" stroke="var(--border-subtle)" />
      <text x="274" y="240" fill="var(--text-primary)" font-size="10" font-weight="600">Item-Level DLQ</text>
      <text x="274" y="255" fill="var(--text-muted)" font-size="9">Zero silent bulk drops</text>

      <path d="M 444 154 L 488 154" stroke="var(--accent)" stroke-width="1.75" marker-end="url(#arrow-cs)" />

      <!-- Stage 3: 4-Tier Elasticsearch Ranking -->
      <rect x="492" y="28" width="372" height="252" rx="6" fill="var(--bg-subtle)" stroke="var(--accent)" stroke-width="1.75" />
      <text x="510" y="52" fill="var(--accent)" font-size="10" font-weight="700">03 / 4-TIER SKU ANALYZER &amp; RANKING (77% SLASH SKUs)</text>
      <text x="510" y="74" fill="var(--text-primary)" font-size="12" font-weight="600">Elasticsearch 26M-Doc Cluster</text>

      <rect x="510" y="90" width="168" height="48" rx="4" fill="var(--bg-surface)" stroke="var(--border-subtle)" />
      <text x="520" y="109" fill="var(--accent)" font-size="10" font-weight="700">T1: Exact Match</text>
      <text x="520" y="125" fill="var(--text-secondary)" font-size="9">Verbatim part number</text>

      <rect x="688" y="90" width="160" height="48" rx="4" fill="var(--bg-surface)" stroke="var(--border-subtle)" />
      <text x="698" y="109" fill="var(--accent)" font-size="10" font-weight="700">T2: Normalized</text>
      <text x="698" y="125" fill="var(--text-secondary)" font-size="9">Punctuation stripped</text>

      <rect x="510" y="148" width="168" height="48" rx="4" fill="var(--bg-surface)" stroke="var(--border-subtle)" />
      <text x="520" y="167" fill="var(--text-primary)" font-size="10" font-weight="600">T3: Prefix</text>
      <text x="520" y="183" fill="var(--text-secondary)" font-size="9">Slash-aware prefix</text>

      <rect x="688" y="148" width="160" height="48" rx="4" fill="var(--bg-surface)" stroke="var(--border-subtle)" />
      <text x="698" y="167" fill="var(--text-primary)" font-size="10" font-weight="600">T4: Fuzzy + Popularity</text>
      <text x="698" y="183" fill="var(--text-secondary)" font-size="9">Typo-tolerant + tie-break</text>

      <rect x="510" y="210" width="338" height="52" rx="4" fill="var(--bg-surface)" stroke="var(--border-strong)" />
      <text x="524" y="232" fill="var(--text-primary)" font-size="10" font-weight="700">Scoped Facet Aggregations: 100,000 → 500 Buckets (-99.5%)</text>
      <text x="524" y="249" fill="var(--text-muted)" font-size="9">Eliminated coordinator heap saturation while preserving filter precision</text>
    </svg>
  )}

  {diagramId === 'agentic-mcp' && (
    <svg
      viewBox="0 0 880 320"
      role="img"
      aria-labelledby="diag-mcp-title diag-mcp-desc"
      style="width: 100%; height: auto; min-width: 580px; font-family: var(--font-mono);"
    >
      <title id="diag-mcp-title">{title}</title>
      <desc id="diag-mcp-desc">{caption}</desc>
      <defs>
        <marker id="arrow-mcp" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--accent)" />
        </marker>
      </defs>

      <!-- Left: Client Surfaces -->
      <rect x="16" y="24" width="190" height="125" rx="6" fill="var(--bg-subtle)" stroke="var(--border-strong)" stroke-width="1.5" />
      <text x="30" y="48" fill="var(--accent)" font-size="10" font-weight="700">IN-APP &amp; BROWSER</text>
      <text x="30" y="70" fill="var(--text-primary)" font-size="12" font-weight="600">Peregrin Web + Ext</text>
      <text x="30" y="90" fill="var(--text-secondary)" font-size="10">• Active Viewport Priority</text>
      <text x="30" y="106" fill="var(--text-secondary)" font-size="10">• Untrusted CSV Search</text>
      <text x="30" y="122" fill="var(--text-secondary)" font-size="10">• Chrome/Edge Supplier Agent</text>

      <rect x="16" y="168" width="190" height="125" rx="6" fill="var(--bg-subtle)" stroke="var(--border-strong)" stroke-width="1.5" />
      <text x="30" y="192" fill="var(--accent)" font-size="10" font-weight="700">EXTERNAL AI CLIENTS</text>
      <text x="30" y="214" fill="var(--text-primary)" font-size="12" font-weight="600">Claude · ChatGPT · IDE</text>
      <text x="30" y="234" fill="var(--text-secondary)" font-size="10">• OAuth 2.1 + PKCE Flow</text>
      <text x="30" y="250" fill="var(--text-secondary)" font-size="10">• Stateless HTTP/SSE</text>
      <text x="30" y="266" fill="var(--text-secondary)" font-size="10">• 36 Tools · 156 Tests</text>

      <path d="M 206 86 L 252 86" stroke="var(--accent)" stroke-width="1.75" marker-end="url(#arrow-mcp)" />
      <path d="M 206 230 L 252 230" stroke="var(--accent)" stroke-width="1.75" marker-end="url(#arrow-mcp)" />

      <!-- Center: Orchestration & MCP Runtime -->
      <rect x="256" y="24" width="250" height="269" rx="6" fill="var(--bg-subtle)" stroke="var(--accent)" stroke-width="1.75" />
      <text x="272" y="48" fill="var(--accent)" font-size="10" font-weight="700">AGENT &amp; MCP RUNTIME LAYER</text>
      <rect x="272" y="62" width="218" height="68" rx="4" fill="var(--bg-surface)" stroke="var(--border-subtle)" />
      <text x="284" y="82" fill="var(--text-primary)" font-size="11" font-weight="700">Azure AI Foundry (42 Tools)</text>
      <text x="284" y="100" fill="var(--text-secondary)" font-size="9">Strict JSON Schema + 25/25 Golden Eval</text>
      <text x="284" y="115" fill="var(--text-muted)" font-size="9">eParts Brain Cortex Hybrid RAG</text>

      <rect x="272" y="142" width="218" height="62" rx="4" fill="var(--bg-surface)" stroke="var(--border-subtle)" />
      <text x="284" y="162" fill="var(--text-primary)" font-size="11" font-weight="700">Permit ReBAC Authorization</text>
      <text x="284" y="180" fill="var(--text-secondary)" font-size="9">Tenant/Workspace tuple verification</text>
      <text x="284" y="194" fill="var(--text-muted)" font-size="9">"My orders" bound to session.userId</text>

      <rect x="272" y="216" width="218" height="62" rx="4" fill="var(--bg-surface)" stroke="var(--border-strong)" />
      <text x="284" y="236" fill="var(--accent)" font-size="10" font-weight="700">Continuous Eval Loop</text>
      <text x="284" y="252" fill="var(--text-secondary)" font-size="9">100 Redacted Traces/Cycle + CI Judge</text>
      <text x="284" y="266" fill="var(--text-muted)" font-size="9">Weekly PR regression gate</text>

      <path d="M 506 110 L 556 110" stroke="var(--accent)" stroke-width="1.75" marker-end="url(#arrow-mcp)" />
      <path d="M 506 215 L 556 215" stroke="var(--accent)" stroke-width="1.75" marker-end="url(#arrow-mcp)" />

      <!-- Right: Two-Phase Write Guard -->
      <rect x="560" y="24" width="304" height="118" rx="6" fill="var(--bg-subtle)" stroke="var(--border-strong)" stroke-width="1.5" />
      <text x="576" y="48" fill="var(--text-muted)" font-size="10" font-weight="700">READ_SAFE EXECUTION PATH</text>
      <text x="576" y="70" fill="var(--text-primary)" font-size="12" font-weight="600">Scoped Data &amp; Hybrid RAG</text>
      <text x="576" y="92" fill="var(--text-secondary)" font-size="10">• 26M Catalog &amp; 35K Spec Docs</text>
      <text x="576" y="108" fill="var(--text-secondary)" font-size="10">• Snowflake Cortex MCP (Brain)</text>
      <text x="576" y="124" fill="var(--text-secondary)" font-size="10">• Zero cross-workspace leakage</text>

      <rect x="560" y="158" width="304" height="135" rx="6" fill="var(--bg-subtle)" stroke="var(--accent)" stroke-width="1.75" />
      <text x="576" y="182" fill="var(--accent)" font-size="10" font-weight="700">WRITE_GUARDED PATH (HUMAN-IN-LOOP)</text>
      <text x="576" y="204" fill="var(--text-primary)" font-size="12" font-weight="600">Signed 5-Minute Action Token</text>
      <text x="576" y="226" fill="var(--text-secondary)" font-size="10">1. Stage dry-run diff + HMAC token</text>
      <text x="576" y="244" fill="var(--text-secondary)" font-size="10">2. User explicitly clicks Confirm</text>
      <text x="576" y="262" fill="var(--text-secondary)" font-size="10">3. Verify TTL (≤5m) &amp; commit audit log</text>
    </svg>
  )}

  {diagramId === 'cdc-snowflake' && (
    <svg
      viewBox="0 0 880 300"
      role="img"
      aria-labelledby="diag-cdc-title diag-cdc-desc"
      style="width: 100%; height: auto; min-width: 580px; font-family: var(--font-mono);"
    >
      <title id="diag-cdc-title">{title}</title>
      <desc id="diag-cdc-desc">{caption}</desc>
      <defs>
        <marker id="arrow-cdc" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--accent)" />
        </marker>
      </defs>

      <!-- Stage 1: Two Source Databases (436 tables + 74 tables) -->
      <rect x="16" y="24" width="176" height="142" rx="6" fill="var(--bg-subtle)" stroke="var(--border-strong)" stroke-width="1.5" />
      <text x="28" y="46" fill="var(--accent)" font-size="10" font-weight="700">01A / PRIMARY OLTP DB</text>
      <text x="28" y="66" fill="var(--text-primary)" font-size="11.5" font-weight="600">SQL Server (436 Tables)</text>
      <text x="28" y="86" fill="var(--text-secondary)" font-size="9.5">• LSN Change Tables</text>
      <text x="28" y="102" fill="var(--text-secondary)" font-size="9.5">• Dynamic Masking (18 tbls)</text>
      <text x="28" y="118" fill="var(--text-muted)" font-size="9">• v5 Partitioned Schema</text>
      <text x="28" y="132" fill="var(--text-muted)" font-size="9">  (Billions-row pricing)</text>

      <rect x="16" y="178" width="176" height="98" rx="6" fill="var(--bg-subtle)" stroke="var(--border-strong)" stroke-width="1.5" />
      <text x="28" y="200" fill="var(--accent)" font-size="10" font-weight="700">01B / SECOND SOURCE DB</text>
      <text x="28" y="220" fill="var(--text-primary)" font-size="11.5" font-weight="600">2nd DB (74 Tables)</text>
      <text x="28" y="240" fill="var(--text-secondary)" font-size="9.5">• ~2.1M-Row Snapshot</text>
      <text x="28" y="256" fill="var(--text-secondary)" font-size="9.5">• Separate CDC Stream</text>

      <path d="M 192 95 L 236 95" stroke="var(--accent)" stroke-width="1.75" marker-end="url(#arrow-cdc)" />
      <path d="M 192 227 L 236 227" stroke="var(--accent)" stroke-width="1.75" stroke-dasharray="4 3" marker-end="url(#arrow-cdc)" />

      <!-- Stage 2: Shared AKS Strimzi Kafka + 3 Consumers -->
      <rect x="240" y="24" width="236" height="252" rx="6" fill="var(--bg-subtle)" stroke="var(--border-strong)" stroke-width="1.5" />
      <text x="254" y="46" fill="var(--accent)" font-size="10" font-weight="700">02 / SHARED KAFKA + 3 CONSUMERS</text>
      <text x="254" y="66" fill="var(--text-primary)" font-size="11.5" font-weight="600">Debezium + Strimzi on AKS</text>

      <rect x="254" y="78" width="208" height="54" rx="4" fill="var(--bg-surface)" stroke="var(--border-subtle)" />
      <text x="264" y="96" fill="var(--accent)" font-size="10" font-weight="700">Consumers #1 &amp; #2 (Same Kafka)</text>
      <text x="264" y="112" fill="var(--text-secondary)" font-size="9">Fan out 436 tables → 2 Snowflakes</text>
      <text x="264" y="125" fill="var(--text-muted)" font-size="8.5">Independent offsets per destination</text>

      <rect x="254" y="140" width="208" height="48" rx="4" fill="var(--bg-surface)" stroke="var(--border-subtle)" />
      <text x="264" y="158" fill="var(--text-primary)" font-size="10" font-weight="700">Consumer #3 (Separate Consumer)</text>
      <text x="264" y="174" fill="var(--text-secondary)" font-size="9">Streams 74 tables → Snowflake #1</text>

      <rect x="254" y="196" width="208" height="68" rx="4" fill="var(--bg-surface)" stroke="var(--border-strong)" />
      <text x="264" y="214" fill="var(--text-primary)" font-size="9.5" font-weight="700">Auto-Restart · 15-Min Lag Watchdog</text>
      <text x="264" y="230" fill="var(--text-secondary)" font-size="9">• Terraform + Helm + Fail-Closed CI</text>
      <text x="264" y="246" fill="var(--text-muted)" font-size="9">• Eliminated multi-day restart gaps</text>

      <!-- Arrows from 3 Consumers to 2 Snowflakes -->
      <path d="M 476 92 L 512 92" stroke="var(--accent)" stroke-width="1.75" marker-end="url(#arrow-cdc)" />
      <path d="M 476 116 L 496 116 L 496 216 L 512 216" stroke="var(--accent)" stroke-width="1.75" marker-end="url(#arrow-cdc)" />
      <path d="M 476 164 L 490 164 L 490 112 L 512 112" stroke="var(--accent)" stroke-width="1.5" stroke-dasharray="4 3" marker-end="url(#arrow-cdc)" />

      <!-- Stage 3: 2 Snowflake Destinations & Batched Drain Engine (-95% Spend) -->
      <rect x="516" y="24" width="348" height="252" rx="6" fill="var(--bg-subtle)" stroke="var(--accent)" stroke-width="1.75" />
      <text x="532" y="46" fill="var(--accent)" font-size="10" font-weight="700">03 / 2 SNOWFLAKE INSTANCES (-95% COMPUTE SPEND)</text>

      <rect x="532" y="58" width="316" height="82" rx="4" fill="var(--bg-surface)" stroke="var(--border-strong)" />
      <text x="544" y="78" fill="var(--text-primary)" font-size="10.5" font-weight="700">Snowflake #1: 436 Tables (C#1) + 74 Tables (C#3)</text>
      <text x="544" y="96" fill="var(--text-secondary)" font-size="9.5">• Hosts 436-table Bronze + 74-table 2nd-DB feed</text>
      <text x="544" y="112" fill="var(--accent)" font-size="9.5" font-weight="700">• Siemens Zero-Leak CDC Share (74 tbls · ~2.1M rows)</text>
      <text x="544" y="128" fill="var(--text-muted)" font-size="8.5">  Pricing withheld · negative-tested read-only role · 2x/day</text>

      <rect x="532" y="148" width="316" height="50" rx="4" fill="var(--bg-surface)" stroke="var(--border-subtle)" />
      <text x="544" y="168" fill="var(--text-primary)" font-size="10.5" font-weight="700">Snowflake #2: 436 Tables via Consumer #2</text>
      <text x="544" y="185" fill="var(--text-secondary)" font-size="9.5">• Replicated from the same Kafka cluster via 2nd consumer</text>

      <rect x="532" y="206" width="316" height="58" rx="4" fill="var(--bg-surface)" stroke="var(--border-strong)" />
      <text x="544" y="224" fill="var(--accent)" font-size="10" font-weight="700">Batched MERGEs + Auto-Suspend (~48 Credits/Day → -95%)</text>
      <text x="544" y="240" fill="var(--text-secondary)" font-size="9.5">• 500K+ rows/run in ~1 hr · scheduled drains · retries &amp; DLQ</text>
      <text x="544" y="254" fill="var(--text-muted)" font-size="8.5">• Replaced always-on per-record MERGE queries</text>
    </svg>
  )}

  {diagramId === 'rag-etim' && (
    <svg
      viewBox="0 0 880 300"
