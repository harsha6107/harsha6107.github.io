      <text x="520" y="125" fill="var(--text-secondary)" font-size="9">6204-2RS/C3 verbatim</text>

      <rect x="688" y="90" width="160" height="48" rx="4" fill="var(--bg-surface)" stroke="var(--border-subtle)" />
      <text x="698" y="109" fill="var(--accent)" font-size="10" font-weight="700">T2: Alnum Fold (8.5x)</text>
      <text x="698" y="125" fill="var(--text-secondary)" font-size="9">Strips / - . → 62042rsc3</text>

      <rect x="510" y="148" width="168" height="48" rx="4" fill="var(--bg-surface)" stroke="var(--border-subtle)" />
      <text x="520" y="167" fill="var(--text-primary)" font-size="10" font-weight="600">T3: Edge Prefix (4.0x)</text>
      <text x="520" y="183" fill="var(--text-secondary)" font-size="9">Slash-aware n-gram</text>

      <rect x="688" y="148" width="160" height="48" rx="4" fill="var(--bg-surface)" stroke="var(--border-subtle)" />
      <text x="698" y="167" fill="var(--text-primary)" font-size="10" font-weight="600">T4: Fuzzy + Pop (1.5x)</text>
