      <desc id="diag-rag-desc">{caption}</desc>
      <defs>
        <marker id="arrow-rag" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 10 5 L 0 9 z" fill="var(--accent)" />
        </marker>
      </defs>

      <!-- Track A: 28GB RAG -->
      <rect x="16" y="24" width="848" height="122" rx="6" fill="var(--bg-subtle)" stroke="var(--border-strong)" stroke-width="1.5" />
