      <rect x="32" y="200" width="180" height="66" rx="4" fill="var(--bg-surface)" stroke="var(--border-subtle)" />
      <text x="44" y="222" fill="var(--text-primary)" font-size="11" font-weight="600">OCR Extraction</text>
      <text x="44" y="240" fill="var(--text-secondary)" font-size="10">~95% OCR Accuracy</text>
