      <path d="M 212 95 L 248 95" stroke="var(--accent)" stroke-width="1.75" marker-end="url(#arrow-rag)" />

      <rect x="252" y="60" width="196" height="70" rx="4" fill="var(--bg-surface)" stroke="var(--border-subtle)" />
      <text x="264" y="82" fill="var(--accent)" font-size="11" font-weight="700">File Deduplication</text>
      <text x="264" y="100" fill="var(--text-secondary)" font-size="9">~29K Unique Files (28 GB)</text>
      <text x="264" y="114" fill="var(--text-muted)" font-size="9">Parallel Azure Blob Workers</text>

      <path d="M 448 95 L 484 95" stroke="var(--accent)" stroke-width="1.75" marker-end="url(#arrow-rag)" />

      <rect x="488" y="60" width="356" height="70" rx="4" fill="var(--bg-surface)" stroke="var(--border-strong)" />
      <text x="502" y="82" fill="var(--text-primary)" font-size="11" font-weight="700">Azure AI Search Index + Product Search Link</text>
      <text x="502" y="100" fill="var(--text-secondary)" font-size="10">~35K Spec &amp; Installation Docs Indexed (~98% Success)</text>
      <text x="502" y="116" fill="var(--text-muted)" font-size="9">Answers linked directly back to product search</text>

      <!-- Track B: ETIM Classification -->
      <rect x="16" y="164" width="848" height="118" rx="6" fill="var(--bg-subtle)" stroke="var(--accent)" stroke-width="1.75" />
