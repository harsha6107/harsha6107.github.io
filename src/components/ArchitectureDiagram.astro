      <text x="40" y="238" fill="var(--text-muted)" font-size="9">pricing delta timestamps</text>

      <path d="M 192 150 L 236 150" stroke="var(--accent)" stroke-width="1.75" marker-end="url(#arrow-cdc)" />

      <!-- AKS Strimzi + Debezium -->
      <rect x="240" y="30" width="224" height="240" rx="6" fill="var(--bg-subtle)" stroke="var(--border-strong)" stroke-width="1.5" />
      <text x="256" y="54" fill="var(--accent)" font-size="10" font-weight="700">02 / STREAMING (AKS)</text>
      <text x="256" y="76" fill="var(--text-primary)" font-size="12" font-weight="600">Debezium + Strimzi Kafka</text>
      <text x="256" y="98" fill="var(--text-secondary)" font-size="10">• Provisioned via Terraform/Helm</text>
      <text x="256" y="116" fill="var(--text-secondary)" font-size="10">• Connector Task Auto-Restart</text>
      <rect x="256" y="136" width="192" height="54" rx="4" fill="var(--bg-surface)" stroke="var(--border-subtle)" />
      <text x="268" y="156" fill="var(--accent)" font-size="10" font-weight="700">15-Min Lag &amp; DLQ Watchdog</text>
